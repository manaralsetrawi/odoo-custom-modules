<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Extend invoice form to add finance review workflow for customer invoices only -->
    <record id="view_move_form_inherit_finance_review" model="ir.ui.view">
        <field name="name">account.move.form.finance.review.workflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

<!-- Review action buttons in header -->
<xpath expr="//header" position="inside">

    <!-- Finance invoice user can submit for review -->
    <button name="action_submit_finance_review"
            type="object"
            string="Submit for Review"
            class="btn-primary"
            groups="finance_review_workflow.group_finance_invoice_user,finance_review_workflow.group_finance_invoice_reviewer"
            invisible="move_type != 'out_invoice' or state != 'draft' or finance_review_state != 'draft'"/>

    <!-- Only finance reviewer can approve -->
    <button name="action_approve_finance_review"
            type="object"
            string="Approve"
            class="btn-success"
            groups="finance_review_workflow.group_finance_invoice_reviewer"
            invisible="move_type != 'out_invoice' or state != 'draft' or finance_review_state != 'submitted'"/>

    <!-- Only finance reviewer can reject -->
    <button name="action_reject_finance_review"
            type="object"
            string="Reject"
            class="btn-secondary"
            groups="finance_review_workflow.group_finance_invoice_reviewer"
            invisible="move_type != 'out_invoice' or state != 'draft' or finance_review_state != 'submitted'"/>

    <!-- Only finance reviewer can reset review state -->
    <button name="action_reset_finance_review_to_draft"
            type="object"
            string="Return to Draft"
            class="btn-secondary"
            groups="finance_review_workflow.group_finance_invoice_reviewer"
            invisible="move_type != 'out_invoice' or state != 'draft' or finance_review_state == 'draft'"/>

    <button name="action_check_finance_exceptions"
        type="object"
        string="Check Exceptions"
        class="btn-secondary"
        invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'draft'"/>

    <button name="action_check_vendor_bill_readiness"
        type="object"
        string="Check Readiness"
        class="btn-secondary"
        invisible="move_type != 'in_invoice' or state != 'draft'"/>

</xpath>

            <!-- Show workflow status clearly near invoice date -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="finance_review_state"
                       widget="statusbar"
                       statusbar_visible="draft,submitted,approved,rejected"
                       readonly="1"
                       invisible="move_type != 'out_invoice'"/>
            </xpath>

            <!-- Add separate Finance Review tab next to Other Info -->
            <xpath expr="//notebook" position="inside">
                <page string="Finance Review" invisible="move_type != 'out_invoice'">

                    <group>
                        <group string="Review Status">
                            <field name="finance_review_state" readonly="1"/>
                            <field name="finance_reject_reason"
                                   placeholder="Enter the reason if the invoice is rejected..."
                                   invisible="finance_review_state != 'rejected'"/>
                        </group>
                    </group>

                    <group>
                        <group string="Submission Details">
                            <field name="finance_submitted_by" readonly="1"/>
                            <field name="finance_submitted_on" readonly="1"/>
                        </group>

                        <group string="Approval Details">
                            <field name="finance_approved_by" readonly="1"/>
                            <field name="finance_approved_on" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Rejection Details">
                            <field name="finance_rejected_by" readonly="1"/>
                            <field name="finance_rejected_on" readonly="1"/>
                        </group>
                    </group>

                </page>

        <page string="AP/AR Exception Control" invisible="move_type not in ('out_invoice', 'in_invoice')">

    <group>
        <group string="Exception Result">
            <field name="finance_exception_status" readonly="1"/>
            <field name="finance_exception_summary" readonly="1" nolabel="0"/>
        </group>
    </group>

    <group>
        <group string="Validation Checks">
            <field name="finance_missing_due_date" readonly="1"/>
            <field name="finance_missing_tax" readonly="1"/>
            <field name="finance_invalid_date_sequence" readonly="1"/>
        </group>

        <group string="Vendor Bill Checks" invisible="move_type != 'in_invoice'">
            <field name="finance_missing_vendor_ref" readonly="1"/>
            <field name="finance_duplicate_vendor_ref" readonly="1"/>
        </group>
    </group>
        </page>

    <page string="Vendor Bill Readiness" invisible="move_type != 'in_invoice'">

    <group>
        <group string="Readiness Result">
            <field name="finance_readiness_status" readonly="1"/>
            <field name="finance_readiness_summary" readonly="1"/>
        </group>
    </group>

    <group>
        <group string="Main Checks">
            <field name="finance_missing_bill_reference" readonly="1"/>
            <field name="finance_missing_bill_tax" readonly="1"/>
            <field name="finance_missing_payment_term" readonly="1"/>
            <field name="finance_missing_attachment" readonly="1"/>
        </group>
    </group>

    </page>  
            </xpath>

        </field>
    </record>

        <!-- Add finance review status column to customer invoice list view -->
<record id="view_out_invoice_tree_inherit_finance_review" model="ir.ui.view">
    <field name="name">account.move.out.invoice.tree.finance.review</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_out_invoice_tree"/>
    <field name="arch" type="xml">

        <!-- Add a colored finance review status badge after invoice date -->
        <xpath expr="//list/field[@name='invoice_date']" position="after">
            <field name="finance_review_state"
                   string="Finance Review Status"
                   widget="badge"
                   optional="show"
                   decoration-muted="finance_review_state == 'draft'"
                   decoration-warning="finance_review_state == 'submitted'"
                   decoration-success="finance_review_state == 'approved'"
                   decoration-danger="finance_review_state == 'rejected'"/>
                   
            <field name="finance_exception_status"
                    string="Exception Status"
                    widget="badge"
                    optional="show"
                    decoration-success="finance_exception_status == 'valid'"
                    decoration-warning="finance_exception_status == 'has_issue'"
                    decoration-danger="finance_exception_status == 'blocked'"/>
        </xpath>

    </field>
</record>
<record id="view_in_invoice_tree_inherit_finance_readiness" model="ir.ui.view">
    <field name="name">account.move.in.invoice.tree.finance.readiness</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_in_invoice_tree"/>
    <field name="arch" type="xml">

        <!-- Add readiness status after bill date -->
        <xpath expr="//list/field[@name='invoice_date']" position="after">
            <field name="finance_readiness_status"
                   string="Readiness Status"
                   widget="badge"
                   optional="show"
                   decoration-danger="finance_readiness_status == 'incomplete'"
                   decoration-success="finance_readiness_status == 'ready'"/>
        </xpath>

    </field>
</record>

</odoo>