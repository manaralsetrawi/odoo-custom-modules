<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Customer invoice kanban                                   -->
    <!-- ========================================================= -->
    <record id="view_out_invoice_kanban_frw" model="ir.ui.view">
        <field name="name">account.move.out.invoice.kanban.frw</field>
        <field name="model">account.move</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <kanban class="frw-kanban-view frw-kanban-invoice" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due"/>
                <field name="finance_review_state"/>
                <field name="finance_exception_status"/>
                <field name="state"/>
                <field name="payment_state"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click frw-kanban-card">

                            <div class="frw-kanban-title">
                                <strong><field name="name"/></strong>
                            </div>

                            <div class="frw-kanban-subtitle">
                                <field name="partner_id"/>
                            </div>

                            <div class="frw-kanban-divider"/>

                            <div class="frw-kanban-section">
                                <div class="frw-kanban-section-title">Summary</div>

                                <div class="frw-kanban-meta-grid">
                                    <div class="frw-meta-item">
                                        <div class="frw-meta-label">Invoice Date</div>
                                        <div class="frw-meta-value"><field name="invoice_date"/></div>
                                    </div>

                                    <div class="frw-meta-item">
                                        <div class="frw-meta-label">Due Date</div>
                                        <div class="frw-meta-value"><field name="invoice_date_due"/></div>
                                    </div>
                                </div>

                                <div class="frw-kanban-amount">
                                    <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                            </div>

                            <div class="frw-kanban-section frw-status-section">
                                <div class="frw-kanban-section-title">Status</div>

                                <!-- Custom finance statuses -->
                                <div class="frw-status-row">
                                    <div class="frw-status-label">Review</div>
                                    <div class="frw-status-value">
                                        <t t-set="review_state" t-value="record.finance_review_state.raw_value or 'draft'"/>
                                        <span t-attf-class="frw-chip frw-chip-#{review_state}">
                                            <t t-if="review_state == 'draft'">Waiting Review</t>
                                            <t t-elif="review_state == 'submitted'">Under Review</t>
                                            <t t-elif="review_state == 'approved'">Approved</t>
                                            <t t-elif="review_state == 'rejected'">Rejected</t>
                                        </span>
                                    </div>
                                </div>

                                <div class="frw-status-row">
                                    <div class="frw-status-label">Check</div>
                                    <div class="frw-status-value">
                                        <t t-set="exception_state" t-value="record.finance_exception_status.raw_value or 'valid'"/>
                                        <span t-attf-class="frw-chip frw-chip-#{exception_state}">
                                            <t t-if="exception_state == 'valid'">No Issues</t>
                                            <t t-elif="exception_state == 'has_issue'">Needs Attention</t>
                                            <t t-elif="exception_state == 'blocked'">Blocked</t>
                                        </span>
                                    </div>
                                </div>

                                <!-- Odoo default statuses -->
                                <div class="frw-status-row">
                                    <div class="frw-status-label">Document</div>
                                    <div class="frw-status-value">
                                        <t t-set="doc_state" t-value="record.state.raw_value or 'draft'"/>
                                        <span t-attf-class="frw-chip frw-chip-doc-#{doc_state}">
                                            <t t-if="doc_state == 'draft'">Draft</t>
                                            <t t-elif="doc_state == 'posted'">Posted</t>
                                            <t t-elif="doc_state == 'cancel'">Cancelled</t>
                                            <t t-else="">Unknown</t>
                                        </span>
                                    </div>
                                </div>

                                <div class="frw-status-row">
                                    <div class="frw-status-label">Payment</div>
                                    <div class="frw-status-value">
                                        <t t-set="pay_state" t-value="record.payment_state.raw_value or 'not_paid'"/>
                                        <span t-attf-class="frw-chip frw-chip-pay-#{pay_state}">
                                            <t t-if="pay_state == 'not_paid'">Not Paid</t>
                                            <t t-elif="pay_state == 'in_payment'">In Payment</t>
                                            <t t-elif="pay_state == 'paid'">Paid</t>
                                            <t t-elif="pay_state == 'partial'">Partial</t>
                                            <t t-elif="pay_state == 'reversed'">Reversed</t>
                                            <t t-elif="pay_state == 'invoicing_legacy'">Legacy</t>
                                            <t t-else="">-</t>
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_out_invoice_kanban_frw_action_link" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="finance_review_workflow.view_out_invoice_kanban_frw"/>
        <field name="act_window_id" ref="account.action_move_out_invoice"/>
    </record>

    <record id="account.action_move_out_invoice" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
    </record>

