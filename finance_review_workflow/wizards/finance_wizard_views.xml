<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Reject Invoice Wizard -->
    <record id="view_finance_invoice_reject_wizard_form" model="ir.ui.view">
        <field name="name">finance.invoice.reject.wizard.form</field>
        <field name="model">finance.invoice.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Invoice">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="Enter the reason for rejecting this invoice..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            type="object"
                            string="Confirm Reject"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Exception Result Wizard -->
    <record id="view_finance_exception_result_wizard_form" model="ir.ui.view">
        <field name="name">finance.exception.result.wizard.form</field>
        <field name="model">finance.exception.result.wizard</field>
        <field name="arch" type="xml">
            <form string="Exception Check Result">
                <group>
                    <group string="Result">
                        <field name="move_id" readonly="1"/>
                        <field name="finance_exception_status" readonly="1"/>
                        <field name="finance_exception_summary" readonly="1"/>
                    </group>
                </group>

                <group>
                    <group string="What Needs Attention">
                        <field name="finance_missing_invoice_date" readonly="1"/>
                        <field name="finance_missing_payment_term" readonly="1"/>
                        <field name="finance_missing_due_date" readonly="1"/>
                        <field name="finance_missing_tax" readonly="1"/>
                        <field name="finance_invalid_date_sequence" readonly="1"/>
                    </group>
                    <group string="Vendor Bill Issues">
                        <field name="finance_missing_vendor_ref" readonly="1"/>
                        <field name="finance_duplicate_vendor_ref" readonly="1"/>
                    </group>
                </group>

                <footer>
                    <button string="Close"
                            special="cancel"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Old compatibility wizard kept safe -->
    <record id="view_finance_bill_completeness_wizard_form" model="ir.ui.view">
        <field name="name">finance.bill.completeness.wizard.form</field>
        <field name="model">finance.bill.completeness.wizard</field>
        <field name="arch" type="xml">
            <form string="Bill Completeness Check">
                <group>
                    <group string="Result">
                        <field name="move_id" readonly="1"/>
                        <field name="finance_readiness_status" readonly="1"/>
                        <field name="finance_readiness_summary" readonly="1"/>
                    </group>
                </group>

                <group>
                    <group string="Main Checks">
                        <field name="finance_missing_bill_reference" readonly="1"/>
                        <field name="finance_missing_bill_tax" readonly="1"/>
                    </group>
                </group>

                <footer>
                    <button string="Close"
                            special="cancel"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>