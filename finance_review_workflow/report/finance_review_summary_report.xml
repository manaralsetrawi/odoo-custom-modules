<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Report action for finance review summary -->
    <record id="action_finance_review_summary_report" model="ir.actions.report">
        <field name="name">Finance Review Summary Report</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">finance_review_workflow.finance_review_summary_template</field>
        <field name="report_file">finance_review_workflow.finance_review_summary_template</field>
        <field name="print_report_name">'Finance Review Summary - %s' % (object.name or 'Document')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>