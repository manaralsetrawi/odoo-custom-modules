<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="finance_review_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Finance Review Summary Report</h2>

                        <table class="table table-sm table-bordered" style="width: 100%; margin-top: 20px;">
                            <tbody>
                                <tr>
                                    <td><strong>Document Number</strong></td>
                                    <td><t t-esc="doc.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Customer / Vendor</strong></td>
                                    <td><t t-esc="doc.partner_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Total Amount</strong></td>
                                    <td><t t-esc="doc.amount_total"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Due Date</strong></td>
                                    <td><t t-esc="doc.invoice_date_due or '-'"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Approval Status</strong></td>
                                    <td>
                                        <t t-if="doc.move_type == 'out_invoice'">
                                            <t t-esc="dict(doc._fields['finance_review_state'].selection).get(doc.finance_review_state, '-')"/>
                                        </t>
                                        <t t-if="doc.move_type == 'in_invoice'">
                                            <t t-esc="dict(doc._fields['invoice_verification_status'].selection).get(doc.invoice_verification_status, '-')"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Reviewer Name</strong></td>
                                    <td>
                                        <t t-if="doc.move_type == 'out_invoice'">
                                            <t t-esc="doc.finance_approved_by.name or '-'"/>
                                        </t>
                                        <t t-if="doc.move_type == 'in_invoice'">
                                            <t t-esc="doc.invoice_verified_by.name or '-'"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Review Date</strong></td>
                                    <td>
                                        <t t-if="doc.move_type == 'out_invoice'">
                                            <t t-esc="doc.finance_approved_on or '-'"/>
                                        </t>
                                        <t t-if="doc.move_type == 'in_invoice'">
                                            <t t-esc="doc.invoice_verified_date or '-'"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Exception Status</strong></td>
                                    <td><t t-esc="dict(doc._fields['finance_exception_status'].selection).get(doc.finance_exception_status, '-')"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Completeness Status</strong></td>
                                    <td>
                                        <t t-if="doc.move_type == 'in_invoice'">
                                            <t t-esc="dict(doc._fields['finance_readiness_status'].selection).get(doc.finance_readiness_status, '-')"/>
                                        </t>
                                        <t t-if="doc.move_type != 'in_invoice'">-</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Rejection Reason</strong></td>
                                    <td>
                                        <t t-if="doc.move_type == 'out_invoice'">
                                            <t t-esc="doc.finance_reject_reason or '-'"/>
                                        </t>
                                        <t t-if="doc.move_type == 'in_invoice'">
                                            <t t-esc="doc.invoice_rejection_reason or '-'"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>