<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="finance_review_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; color: #1f2937;">

                        <!-- Header -->
                        <div style="margin-bottom: 22px;">
                            <div style="font-size: 24px; font-weight: 800; color: #234f84; margin-bottom: 4px;">
                                Finance Review Summary Report
                            </div>
                            <div style="font-size: 13px; color: #64748b;">
                                Review, validation, and document outcome summary
                            </div>
                        </div>

                        <div style="border-top: 3px solid #2d456f; margin-bottom: 18px;"></div>

                        <!-- Document type pill -->
                        <div style="margin-bottom: 18px;">
                            <span style="display: inline-block; background: #eaf2fb; color: #234f84; border: 1px solid #d3e0ee; border-radius: 999px; padding: 8px 16px; font-size: 12px; font-weight: 700;">
                                <t t-if="doc.move_type == 'out_invoice'">Customer Invoice</t>
                                <t t-if="doc.move_type == 'in_invoice'">Vendor Bill</t>
                            </span>
                        </div>

                        <!-- Executive Summary -->
                        <div style="font-size: 15px; font-weight: 400; color: #234f84; margin-bottom: 14px;">
                            Executive Summary
                        </div>

                        <table style="width: 100%; border-collapse: separate; border-spacing: 10px 10px; margin: 0 0 18px 0;">
                            <tr>
                                <td style="width: 33.33%; vertical-align: top;">
                                    <div style="border: 1px solid #d9e3ef; border-radius: 10px; padding: 14px;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 8px;">
                                            Partner
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827; line-height: 1.35;">
                                            <t t-esc="doc.partner_id.name or '-'"/>
                                        </div>
                                    </div>
                                </td>

                                <td style="width: 33.33%; vertical-align: top;">
                                    <div style="border: 1px solid #d9e3ef; border-radius: 10px; padding: 14px;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 8px;">
                                            Document Number
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827; line-height: 1.35;">
                                            <t t-esc="doc.name or '-'"/>
                                        </div>
                                    </div>
                                </td>

                                <td style="width: 33.33%; vertical-align: top;">
                                    <div style="border: 1px solid #d9e3ef; border-radius: 10px; padding: 14px;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 8px;">
                                            Total Amount
                                        </div>
                                        <div style="font-size: 17px; font-weight: 800; color: #233b6a; line-height: 1.35;">
                                            <t t-esc="doc.amount_total"/>
                                            <t t-if="doc.currency_id">
                                                <span style="font-size: 14px; font-weight: 700; color: #475569;">
                                                    <t t-esc="doc.currency_id.name"/>
                                                </span>
                                            </t>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Overview -->
                        <div style="font-size: 15px; font-weight: 400; color: #234f84; margin-bottom: 10px;">
                            Document Overview
                        </div>

                        <div style="border: 1px solid #d9e3ef; border-radius: 10px; padding: 16px; margin-bottom: 18px;">
                            <table style="width: 100%; border-collapse: separate; border-spacing: 0 12px;">
                                <tr>
                                    <td style="width: 50%; vertical-align: top; padding-right: 16px;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 4px;">Invoice / Bill Date</div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827;">
                                            <t t-esc="doc.invoice_date or '-'"/>
                                        </div>
                                    </td>
                                    <td style="width: 50%; vertical-align: top;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 4px;">Due Date</div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827;">
                                            <t t-esc="doc.invoice_date_due or '-'"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 50%; vertical-align: top; padding-right: 16px;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 4px;">Document Type</div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827;">
                                            <t t-if="doc.move_type == 'out_invoice'">Customer Invoice</t>
                                            <t t-if="doc.move_type == 'in_invoice'">Vendor Bill</t>
                                        </div>
                                    </td>
                                    <td style="width: 50%; vertical-align: top;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 4px;">Current State</div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827;">
                                            <t t-if="doc.state == 'draft'">Draft</t>
                                            <t t-elif="doc.state == 'posted'">Posted</t>
                                            <t t-elif="doc.state == 'cancel'">Cancelled</t>
                                            <t t-else=""><t t-esc="doc.state or '-'"/></t>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Review Outcome -->
                        <div style="font-size: 15px; font-weight: 400; color: #234f84; margin-bottom: 10px;">
                            Review Outcome
                        </div>

                        <div style="border: 1px solid #d9e3ef; border-radius: 10px; padding: 16px; margin-bottom: 18px;">
                            <div style="margin-bottom: 14px;">
                                <t t-if="doc.move_type == 'out_invoice'">
                                    <t t-set="review_label" t-value="dict(doc._fields['finance_review_state'].selection).get(doc.finance_review_state, '-')"/>
                                    <span style="display: inline-block; background: #eaf2fb; color: #234f84; border: 1px solid #d3e0ee; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        <t t-esc="review_label"/>
                                    </span>
                                </t>
                                <t t-if="doc.move_type == 'in_invoice'">
                                    <t t-set="verify_label" t-value="dict(doc._fields['invoice_verification_status'].selection).get(doc.invoice_verification_status, '-')"/>
                                    <span style="display: inline-block; background: #eaf2fb; color: #234f84; border: 1px solid #d3e0ee; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        <t t-esc="verify_label"/>
                                    </span>
                                </t>
                            </div>

                            <table style="width: 100%; border-collapse: separate; border-spacing: 0 12px;">
                                <tr>
                                    <td style="width: 50%; vertical-align: top; padding-right: 16px;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 4px;">Reviewer Name</div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827;">
                                            <t t-if="doc.move_type == 'out_invoice'">
                                                <t t-esc="doc.finance_approved_by.name or doc.finance_rejected_by.name or '-'"/>
                                            </t>
                                            <t t-if="doc.move_type == 'in_invoice'">
                                                <t t-esc="doc.invoice_verified_by.name or '-'"/>
                                            </t>
                                        </div>
                                    </td>
                                    <td style="width: 50%; vertical-align: top;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 4px;">Review Date</div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827;">
                                            <t t-if="doc.move_type == 'out_invoice'">
                                                <t t-esc="doc.finance_approved_on or doc.finance_rejected_on or '-'"/>
                                            </t>
                                            <t t-if="doc.move_type == 'in_invoice'">
                                                <t t-esc="doc.invoice_verified_date or '-'"/>
                                            </t>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="vertical-align: top;">
                                        <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 4px;">Rejection Reason</div>
                                        <div style="font-size: 15px; font-weight: 700; color: #111827; line-height: 1.5;">
                                            <t t-if="doc.move_type == 'out_invoice'">
                                                <t t-esc="doc.finance_reject_reason or '-'"/>
                                            </t>
                                            <t t-if="doc.move_type == 'in_invoice'">
                                                <t t-esc="doc.invoice_rejection_reason or '-'"/>
                                            </t>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Alerts & Insights -->
                        <div style="font-size: 15px; font-weight: 400; color: #234f84; margin-bottom: 10px;">
                            Alerts &amp; Insights
                        </div>

                        <div style="border: 1px solid #ead7a4; background: #fbf7ea; border-radius: 10px; padding: 14px 16px; margin-bottom: 18px;">
                            <ul style="margin: 0; padding-left: 18px; color: #1f2937; font-size: 14px; line-height: 1.7;">
                                <li>
                                    <strong>Exception Status:</strong>
                                    <t t-esc="dict(doc._fields['finance_exception_status'].selection).get(doc.finance_exception_status, '-')"/>
                                </li>
                                <li>
                                    <strong>Review Result:</strong>
                                    <t t-if="doc.move_type == 'out_invoice'">
                                        <t t-esc="dict(doc._fields['finance_review_state'].selection).get(doc.finance_review_state, '-')"/>
                                    </t>
                                    <t t-if="doc.move_type == 'in_invoice'">
                                        <t t-esc="dict(doc._fields['invoice_verification_status'].selection).get(doc.invoice_verification_status, '-')"/>
                                    </t>
                                </li>
                                <li>
                                    <strong>Summary:</strong>
                                    <t t-esc="doc.finance_exception_summary or 'No exception found.'"/>
                                </li>
                            </ul>
                        </div>

                        <!-- Validation Summary -->
                        <div style="font-size: 15px; font-weight: 400; color: #234f84; margin-bottom: 10px;">
                            Validation Summary
                        </div>

                        <div style="border: 1px solid #d9e3ef; border-radius: 10px; padding: 16px; margin-bottom: 18px;">
                            <div style="margin-bottom: 14px;">
                                <t t-set="exception_label" t-value="dict(doc._fields['finance_exception_status'].selection).get(doc.finance_exception_status, '-')"/>
                                <span style="display: inline-block; background: #ecfdf3; color: #166534; border: 1px solid #bbf7d0; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                    <t t-esc="exception_label"/>
                                </span>
                            </div>

                            <div style="font-size: 12px; color: #6f85a3; text-transform: uppercase; margin-bottom: 8px;">
                                Detected Checks
                            </div>

                            <div>
                                <t t-if="doc.finance_missing_invoice_date">
                                    <span style="display: inline-block; margin: 0 8px 8px 0; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        Missing Date
                                    </span>
                                </t>

                                <t t-if="doc.finance_missing_payment_term">
                                    <span style="display: inline-block; margin: 0 8px 8px 0; background: #fff7ed; color: #b45309; border: 1px solid #fed7aa; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        Missing Payment Terms / Due Date
                                    </span>
                                </t>

                                <t t-if="doc.finance_missing_due_date">
                                    <span style="display: inline-block; margin: 0 8px 8px 0; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        Missing Due Date
                                    </span>
                                </t>

                                <t t-if="doc.finance_missing_tax">
                                    <span style="display: inline-block; margin: 0 8px 8px 0; background: #fff7ed; color: #b45309; border: 1px solid #fed7aa; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        Missing Tax
                                    </span>
                                </t>

                                <t t-if="doc.finance_invalid_date_sequence">
                                    <span style="display: inline-block; margin: 0 8px 8px 0; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        Invalid Date Sequence
                                    </span>
                                </t>

                                <t t-if="doc.move_type == 'in_invoice' and doc.finance_missing_vendor_ref">
                                    <span style="display: inline-block; margin: 0 8px 8px 0; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        Missing Vendor Reference
                                    </span>
                                </t>

                                <t t-if="doc.move_type == 'in_invoice' and doc.finance_duplicate_vendor_ref">
                                    <span style="display: inline-block; margin: 0 8px 8px 0; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        Duplicate Vendor Reference
                                    </span>
                                </t>

                                <t t-if="not doc.finance_missing_invoice_date and not doc.finance_missing_payment_term and not doc.finance_missing_due_date and not doc.finance_missing_tax and not doc.finance_invalid_date_sequence and not doc.finance_missing_vendor_ref and not doc.finance_duplicate_vendor_ref">
                                    <span style="display: inline-block; margin: 0 8px 8px 0; background: #ecfdf3; color: #166534; border: 1px solid #bbf7d0; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                        No Detailed Issues Found
                                    </span>
                                </t>
                            </div>
                        </div>

                        <!-- Footer note -->
                        <div style="margin-top: 24px; font-size: 12px; color: #6b7280; border-top: 1px solid #e5e7eb; padding-top: 12px;">
                            This report is generated from the current finance review workflow and validation results available in the system.
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>