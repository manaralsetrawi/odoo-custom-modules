<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="finance_review_summary_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; color: #1f2937;">

                        <!-- Header -->
                        <div style="margin-bottom: 26px;">
                            <div style="font-size: 28px; font-weight: 800; color: #0f4c81; margin-bottom: 6px;">
                                Finance Review Summary Report
                            </div>
                            <div style="font-size: 13px; color: #6b7280; margin-bottom: 14px;">
                                Generated summary for finance review, exception checking, and document outcome.
                            </div>

                            <span style="display: inline-block; background: #eef6fb; color: #0f4c81; border: 1px solid #d5e7f5; border-radius: 999px; padding: 7px 14px; font-size: 12px; font-weight: 700;">
                                <t t-if="doc.move_type == 'out_invoice'">Customer Invoice</t>
                                <t t-if="doc.move_type == 'in_invoice'">Vendor Bill</t>
                            </span>
                        </div>

                        <!-- Top summary cards -->
                        <div style="width: 100%; margin-bottom: 18px;">
                            <div style="display: flex; gap: 14px;">

                                <div style="width: 32%; border: 1px solid #dbe7f1; border-radius: 18px; padding: 16px; vertical-align: top;">
                                    <div style="font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #6b7280; margin-bottom: 8px;">
                                        Partner
                                    </div>
                                    <div style="font-size: 18px; font-weight: 700; color: #111827; line-height: 1.35;">
                                        <t t-esc="doc.partner_id.name or '-'"/>
                                    </div>
                                </div>

                                <div style="width: 32%; border: 1px solid #dbe7f1; border-radius: 18px; padding: 16px; vertical-align: top;">
                                    <div style="font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #6b7280; margin-bottom: 8px;">
                                        Total Amount
                                    </div>
                                    <div style="font-size: 22px; font-weight: 800; color: #0f172a; line-height: 1.35;">
                                        <t t-esc="doc.amount_total"/>
                                        <t t-if="doc.currency_id">
                                            <span style="font-size: 15px; font-weight: 700; color: #4b5563;">
                                                <t t-esc="doc.currency_id.name"/>
                                            </span>
                                        </t>
                                    </div>
                                </div>

                                <div style="width: 32%; border: 1px solid #dbe7f1; border-radius: 18px; padding: 16px; vertical-align: top;">
                                    <div style="font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #6b7280; margin-bottom: 8px;">
                                        Document Number
                                    </div>
                                    <div style="font-size: 18px; font-weight: 700; color: #111827; line-height: 1.35;">
                                        <t t-esc="doc.name or '-'"/>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Section 1: Document Overview -->
                        <div style="border: 1px solid #dbe7f1; border-radius: 20px; padding: 18px; margin-bottom: 18px;">
                            <div style="font-size: 16px; font-weight: 800; color: #1e4f86; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.04em;">
                                Document Overview
                            </div>

                            <div style="display: flex; gap: 18px;">

                                <div style="width: 48%;">
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 4px;">
                                            Invoice / Bill Date
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #1f2937;">
                                            <t t-esc="doc.invoice_date or '-'"/>
                                        </div>
                                    </div>

                                    <div style="margin-bottom: 12px;">
                                        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 4px;">
                                            Due Date
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #1f2937;">
                                            <t t-esc="doc.invoice_date_due or '-'"/>
                                        </div>
                                    </div>
                                </div>

                                <div style="width: 48%;">
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 4px;">
                                            Document Type
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #1f2937;">
                                            <t t-if="doc.move_type == 'out_invoice'">Customer Invoice</t>
                                            <t t-if="doc.move_type == 'in_invoice'">Vendor Bill</t>
                                        </div>
                                    </div>

                                    <div style="margin-bottom: 12px;">
                                        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 4px;">
                                            Current State
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #1f2937;">
                                            <t t-esc="doc.state or '-'"/>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Section 2: Review Outcome -->
                        <div style="border: 1px solid #dbe7f1; border-radius: 20px; padding: 18px; margin-bottom: 18px;">
                            <div style="font-size: 16px; font-weight: 800; color: #1e4f86; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.04em;">
                                Review Outcome
                            </div>

                            <!-- status chip -->
                            <div style="margin-bottom: 16px;">
                                <t t-if="doc.move_type == 'out_invoice'">
                                    <t t-set="review_label" t-value="dict(doc._fields['finance_review_state'].selection).get(doc.finance_review_state, '-')"/>
                                    <span style="display: inline-block; background: #eef6fb; color: #0f4c81; border: 1px solid #d5e7f5; border-radius: 999px; padding: 7px 14px; font-size: 12px; font-weight: 700;">
                                        <t t-esc="review_label"/>
                                    </span>
                                </t>
                                <t t-if="doc.move_type == 'in_invoice'">
                                    <t t-set="verify_label" t-value="dict(doc._fields['invoice_verification_status'].selection).get(doc.invoice_verification_status, '-')"/>
                                    <span style="display: inline-block; background: #eef6fb; color: #0f4c81; border: 1px solid #d5e7f5; border-radius: 999px; padding: 7px 14px; font-size: 12px; font-weight: 700;">
                                        <t t-esc="verify_label"/>
                                    </span>
                                </t>
                            </div>

                            <div style="display: flex; gap: 18px;">

                                <div style="width: 48%;">
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 4px;">
                                            Reviewer Name
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #1f2937;">
                                            <t t-if="doc.move_type == 'out_invoice'">
                                                <t t-esc="doc.finance_approved_by.name or doc.finance_rejected_by.name or '-'"/>
                                            </t>
                                            <t t-if="doc.move_type == 'in_invoice'">
                                                <t t-esc="doc.invoice_verified_by.name or '-'"/>
                                            </t>
                                        </div>
                                    </div>

                                    <div style="margin-bottom: 12px;">
                                        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 4px;">
                                            Review Date
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #1f2937;">
                                            <t t-if="doc.move_type == 'out_invoice'">
                                                <t t-esc="doc.finance_approved_on or doc.finance_rejected_on or '-'"/>
                                            </t>
                                            <t t-if="doc.move_type == 'in_invoice'">
                                                <t t-esc="doc.invoice_verified_date or '-'"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                                <div style="width: 48%;">
                                    <div style="margin-bottom: 12px;">
                                        <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 4px;">
                                            Rejection Reason
                                        </div>
                                        <div style="font-size: 15px; font-weight: 700; color: #1f2937; line-height: 1.5;">
                                            <t t-if="doc.move_type == 'out_invoice'">
                                                <t t-esc="doc.finance_reject_reason or '-'"/>
                                            </t>
                                            <t t-if="doc.move_type == 'in_invoice'">
                                                <t t-esc="doc.invoice_rejection_reason or '-'"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Section 3: Validation Summary -->
                        <div style="border: 1px solid #dbe7f1; border-radius: 20px; padding: 18px; margin-bottom: 18px;">
                            <div style="font-size: 16px; font-weight: 800; color: #1e4f86; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.04em;">
                                Validation Summary
                            </div>

                            <div style="margin-bottom: 14px;">
                                <t t-set="exception_label" t-value="dict(doc._fields['finance_exception_status'].selection).get(doc.finance_exception_status, '-')"/>
                                <span style="display: inline-block; background: #ecfdf3; color: #166534; border: 1px solid #bbf7d0; border-radius: 999px; padding: 7px 14px; font-size: 12px; font-weight: 700;">
                                    <t t-esc="exception_label"/>
                                </span>
                            </div>

                            <div style="margin-bottom: 16px;">
                                <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 6px;">
                                    Result Details
                                </div>
                                <div style="font-size: 15px; font-weight: 700; color: #1f2937; line-height: 1.5;">
                                    <t t-esc="doc.finance_exception_summary or '-'"/>
                                </div>
                            </div>

                            <div>
                                <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #7489a8; margin-bottom: 8px;">
                                    Detected Checks
                                </div>

                                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                    <t t-if="doc.finance_missing_due_date">
                                        <span style="display: inline-block; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                            Missing Due Date
                                        </span>
                                    </t>

                                    <t t-if="doc.finance_missing_tax">
                                        <span style="display: inline-block; background: #fff7ed; color: #b45309; border: 1px solid #fed7aa; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                            Missing Tax
                                        </span>
                                    </t>

                                    <t t-if="doc.finance_invalid_date_sequence">
                                        <span style="display: inline-block; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                            Invalid Date Sequence
                                        </span>
                                    </t>

                                    <t t-if="doc.move_type == 'in_invoice' and doc.finance_missing_vendor_ref">
                                        <span style="display: inline-block; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                            Missing Vendor Reference
                                        </span>
                                    </t>

                                    <t t-if="doc.move_type == 'in_invoice' and doc.finance_duplicate_vendor_ref">
                                        <span style="display: inline-block; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                            Duplicate Vendor Reference
                                        </span>
                                    </t>

                                    <t t-if="not doc.finance_missing_due_date and not doc.finance_missing_tax and not doc.finance_invalid_date_sequence and not doc.finance_missing_vendor_ref and not doc.finance_duplicate_vendor_ref">
                                        <span style="display: inline-block; background: #ecfdf3; color: #166534; border: 1px solid #bbf7d0; border-radius: 999px; padding: 6px 12px; font-size: 12px; font-weight: 700;">
                                            No Detailed Issues Found
                                        </span>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- Footer note -->
                        <div style="margin-top: 24px; font-size: 12px; color: #6b7280; border-top: 1px solid #e5e7eb; padding-top: 12px;">
                            This report is generated from the current finance review workflow and validation results available in the system.
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>