<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        Group 1:
        Can create/edit invoices and submit them for review.
        Cannot approve or reject.
    -->
    <record id="group_finance_invoice_user" model="res.groups">
        <field name="name">Finance Invoice User</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
    </record>

    <!--
        Group 2:
        Can review submitted invoices and approve/reject them.
    -->
    <record id="group_finance_invoice_reviewer" model="res.groups">
        <field name="name">Finance Invoice Reviewer</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <!-- Reviewer also inherits normal finance invoice user role -->
        <field name="implied_ids" eval="[(4, ref('finance_review_workflow.group_finance_invoice_user'))]"/>
    </record>

</odoo>