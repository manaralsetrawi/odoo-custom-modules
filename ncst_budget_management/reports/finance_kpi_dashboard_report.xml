<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_finance_kpi_dashboard" model="ir.actions.report">
        <field name="name">Finance Dashboard Report</field>
        <field name="model">finance.kpi.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ncst_budget_management.report_finance_kpi_dashboard_document</field>
        <field name="report_file">ncst_budget_management.report_finance_kpi_dashboard_document</field>
        <field name="print_report_name">'Finance Dashboard - %s' % (object.name or 'Report')</field>
    </record>

    <template id="report_finance_kpi_dashboard_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 13px; color: #1f2937;">

                        <!-- Header -->
                        <div style="margin-bottom: 18px; border-bottom: 2px solid #1e3a5f; padding-bottom: 10px;">
                            <h2 style="margin: 0; color: #1e3a5f; font-size: 24px;">Finance Dashboard Report</h2>
                            <div style="margin-top: 4px; color: #64748b; font-size: 14px;">
                                Budget and Expense Monitoring Summary
                            </div>
                        </div>

                        <!-- Executive Summary -->
                        <div style="margin-bottom: 18px;">
                            <h3 style="margin: 0 0 10px 0; color: #1e3a5f; font-size: 16px;">Executive Summary</h3>

                            <table style="width: 100%; border-collapse: separate; border-spacing: 8px;">
                                <tr>
                                    <td style="width: 33.33%; background: #f8fbff; border: 1px solid #dbe7f3; border-radius: 8px; padding: 12px;">
                                        <div style="font-size: 11px; color: #64748b; text-transform: uppercase;">General Budget for This Year</div>
                                        <div style="margin-top: 6px; font-size: 18px; font-weight: 700; color: #1e3a5f;">
                                            <span t-field="o.general_budget_this_year"/>
                                        </div>
                                    </td>
                                    <td style="width: 33.33%; background: #f8fbff; border: 1px solid #dbe7f3; border-radius: 8px; padding: 12px;">
                                        <div style="font-size: 11px; color: #64748b; text-transform: uppercase;">Total Budget Allocations</div>
                                        <div style="margin-top: 6px; font-size: 18px; font-weight: 700; color: #1e3a5f;">
                                            <span t-field="o.total_budget_allocated"/>
                                        </div>
                                    </td>
                                    <td style="width: 33.33%; background: #f8fbff; border: 1px solid #dbe7f3; border-radius: 8px; padding: 12px;">
                                        <div style="font-size: 11px; color: #64748b; text-transform: uppercase;">Pending Expense Requests</div>
                                        <div style="margin-top: 6px; font-size: 18px; font-weight: 700; color: #1e3a5f;">
                                            <span t-field="o.pending_expense_requests"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="background: #f8fbff; border: 1px solid #dbe7f3; border-radius: 8px; padding: 12px;">
                                        <div style="font-size: 11px; color: #64748b; text-transform: uppercase;">Pending Reservations</div>
                                        <div style="margin-top: 6px; font-size: 18px; font-weight: 700; color: #1e3a5f;">
                                            <span t-field="o.pending_reservations"/>
                                        </div>
                                    </td>
                                    <td style="background: #f8fbff; border: 1px solid #dbe7f3; border-radius: 8px; padding: 12px;">
                                        <div style="font-size: 11px; color: #64748b; text-transform: uppercase;">Expenses This Month</div>
                                        <div style="margin-top: 6px; font-size: 18px; font-weight: 700; color: #1e3a5f;">
                                            <span t-field="o.expenses_this_month"/>
                                        </div>
                                    </td>
                                    <td style="background: #f8fbff; border: 1px solid #dbe7f3; border-radius: 8px; padding: 12px;">
                                        <div style="font-size: 11px; color: #64748b; text-transform: uppercase;">Expenses This Year</div>
                                        <div style="margin-top: 6px; font-size: 18px; font-weight: 700; color: #1e3a5f;">
                                            <span t-field="o.expenses_this_year"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Alerts -->
                        <div style="margin-bottom: 18px;">
                            <h3 style="margin: 0 0 10px 0; color: #1e3a5f; font-size: 16px;">Alerts &amp; Insights</h3>
                            <div style="border: 1px solid #f6d38b; background: #fffaf0; border-radius: 8px; padding: 12px 14px;">
                                <ul style="margin: 0; padding-left: 18px; line-height: 1.7;">
                                    <li><span t-field="o.alert_1"/></li>
                                    <li><span t-field="o.alert_2"/></li>
                                    <li><span t-field="o.alert_3"/></li>
                                </ul>
                            </div>
                        </div>

                        <!-- Budget Metrics -->
                        <div style="margin-bottom: 18px;">
                            <h3 style="margin: 0 0 10px 0; color: #1e3a5f; font-size: 16px;">Budget Metrics</h3>
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr style="background: #f3f6fa;">
                                        <th style="border: 1px solid #d9e2ec; padding: 9px; text-align: left;">Metric</th>
                                        <th style="border: 1px solid #d9e2ec; padding: 9px; text-align: left;">Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">Reserved Budget %</td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">
                                            <t t-esc="'%.2f' % o.reserved_budget_percentage"/>%
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">Paid Budget %</td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">
                                            <t t-esc="'%.2f' % o.paid_budget_percentage"/>%
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">Remaining Budget %</td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">
                                            <t t-esc="'%.2f' % o.remaining_budget_percentage"/>%
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">Average Monthly Expense</td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.average_monthly_expense"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">Projected Annual Expense</td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.projected_annual_expense"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;">Budget Status</td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.remaining_budget_message"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Highlights -->
                        <div style="margin-bottom: 18px;">
                            <h3 style="margin: 0 0 10px 0; color: #1e3a5f; font-size: 16px;">Highlights</h3>
                            <table style="width: 100%; border-collapse: separate; border-spacing: 8px;">
                                <tr>
                                    <td style="width: 50%; background: #fbfdff; border: 1px solid #e5edf5; border-radius: 8px; padding: 12px;">
                                        <div style="font-weight: 700; color: #1e3a5f; margin-bottom: 6px;">Highest Expense Type</div>
                                        <div style="color: #475569;"><span t-field="o.highest_expense_type_summary"/></div>
                                    </td>
                                    <td style="width: 50%; background: #fbfdff; border: 1px solid #e5edf5; border-radius: 8px; padding: 12px;">
                                        <div style="font-weight: 700; color: #1e3a5f; margin-bottom: 6px;">Highest Spending Department</div>
                                        <div style="color: #475569;"><span t-field="o.highest_department_summary"/></div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Tables -->
                        <div style="margin-bottom: 14px;">
                            <h3 style="margin: 0 0 10px 0; color: #1e3a5f; font-size: 16px;">Top Expense Types</h3>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                                <thead>
                                    <tr style="background: #f3f6fa;">
                                        <th style="border: 1px solid #d9e2ec; padding: 9px; text-align: left;">Type</th>
                                        <th style="border: 1px solid #d9e2ec; padding: 9px; text-align: left;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_type_1"/></td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_type_1_amount"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_type_2"/></td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_type_2_amount"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_type_3"/></td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_type_3_amount"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <h3 style="margin: 0 0 10px 0; color: #1e3a5f; font-size: 16px;">Top Spending Departments</h3>
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr style="background: #f3f6fa;">
                                        <th style="border: 1px solid #d9e2ec; padding: 9px; text-align: left;">Department</th>
                                        <th style="border: 1px solid #d9e2ec; padding: 9px; text-align: left;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_department_1"/></td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_department_1_amount"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_department_2"/></td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_department_2_amount"/></td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_department_3"/></td>
                                        <td style="border: 1px solid #d9e2ec; padding: 9px;"><span t-field="o.top_expense_department_3_amount"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Footer note -->
                        <div style="margin-top: 16px; padding-top: 10px; border-top: 1px solid #e5e7eb; color: #64748b; font-size: 12px;">
                            <strong>Last Updated:</strong>
                            <span t-field="o.last_updated"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>