<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_kpi_dashboard_kanban" model="ir.ui.view">
        <field name="name">finance.kpi.dashboard.kanban</field>
        <field name="model">finance.kpi.dashboard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile ncst_finance_kpi_dashboard_kanban" create="0" delete="0">
                <field name="name"/>
                <field name="total_budget_allocated"/>
                <field name="total_reserved_amount"/>
                <field name="total_paid_expenses"/>
                <field name="remaining_budget"/>
                <field name="pending_expense_requests"/>
                <field name="pending_reservations"/>
                <field name="approved_reservations"/>
                <field name="used_reservations"/>
                <field name="rejected_budget_requests"/>
                <field name="last_updated"/>
                <field name="remaining_budget_status"/>
                <field name="remaining_budget_message"/>
                <field name="budget_chart_allocated"/>
                <field name="budget_chart_reserved"/>
                <field name="budget_chart_paid"/>
                <field name="top_expense_type_1"/>
                <field name="top_expense_type_1_amount"/>
                <field name="top_expense_type_2"/>
                <field name="top_expense_type_2_amount"/>
                <field name="top_expense_type_3"/>
                <field name="top_expense_type_3_amount"/>
                <field name="top_expense_department_1"/>
                <field name="top_expense_department_1_amount"/>
                <field name="top_expense_department_2"/>
                <field name="top_expense_department_2_amount"/>
                <field name="top_expense_department_3"/>
                <field name="top_expense_department_3_amount"/>
                <field name="expenses_this_month"/>
                <field name="expenses_this_year"/>
                <field name="general_budget_this_year"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click ncst_finance_kpi_dashboard_card">

                            <div class="ncst_finance_kpi_dashboard_header">
                                <div class="ncst_finance_kpi_dashboard_label">
                                    Finance Dashboard
                                </div>
                                <div class="ncst_finance_kpi_dashboard_title">
                                    Budget and Expense Monitoring
                                </div>
                            </div>

                            <div class="ncst_finance_kpi_dashboard_grid">

                                <div class="ncst_finance_kpi_box ncst_finance_kpi_box_primary">
                                    <div class="ncst_finance_kpi_label">General Budget for This Year</div>
                                    <div class="ncst_finance_kpi_value">
                                        <field name="general_budget_this_year"/>
                                    </div>
                                </div>

                                <div class="ncst_finance_kpi_box ncst_finance_kpi_box_primary">
                                    <div class="ncst_finance_kpi_label">Total Budget Allocations</div>
                                    <div class="ncst_finance_kpi_value">
                                        <field name="total_budget_allocated"/>
                                    </div>
                                </div>

                                <div class="ncst_finance_kpi_box ncst_finance_kpi_box_soft">
                                    <div class="ncst_finance_kpi_label">Pending Expense Requests</div>
                                    <div class="ncst_finance_kpi_value">
                                        <field name="pending_expense_requests"/>
                                    </div>
                                </div>

                                <div class="ncst_finance_kpi_box ncst_finance_kpi_box_soft">
                                    <div class="ncst_finance_kpi_label">Pending Reservations</div>
                                    <div class="ncst_finance_kpi_value">
                                        <field name="pending_reservations"/>
                                    </div>
                                </div>

                                <div class="ncst_finance_kpi_box ncst_finance_kpi_box_soft">
                                    <div class="ncst_finance_kpi_label">Expenses This Month</div>
                                    <div class="ncst_finance_kpi_value">
                                        <field name="expenses_this_month"/>
                                    </div>
                                </div>

                                <div class="ncst_finance_kpi_box ncst_finance_kpi_box_soft">
                                    <div class="ncst_finance_kpi_label">Expenses This Year</div>
                                    <div class="ncst_finance_kpi_value">
                                        <field name="expenses_this_year"/>
                                    </div>
                                </div>
                            </div>

                            <div class="ncst_finance_chart_grid">

                                <div class="ncst_finance_chart_section">
                                    <div class="ncst_finance_chart_title">Budget vs Reserved vs Paid</div>
                                    <div class="ncst_finance_chart_subtitle">
                                        Overview of key budget usage values
                                    </div>
                                    <div class="ncst_finance_chart_rows">
                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">Allocated</div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_allocated"
                                                    t-att-style="'width: ' + (record.budget_chart_allocated.raw_value &amp;&amp; record.budget_chart_allocated.raw_value > 0 ? 100 : 0) + '%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="budget_chart_allocated"/>
                                            </div>
                                        </div>

                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">Reserved</div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_reserved"
                                                    t-att-style="'width: ' + (record.budget_chart_allocated.raw_value &amp;&amp; record.budget_chart_allocated.raw_value > 0 ? (record.budget_chart_reserved.raw_value / record.budget_chart_allocated.raw_value * 100) : 0) + '%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="budget_chart_reserved"/>
                                            </div>
                                        </div>

                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">Paid</div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_paid"
                                                    t-att-style="'width: ' + (record.budget_chart_allocated.raw_value &amp;&amp; record.budget_chart_allocated.raw_value > 0 ? (record.budget_chart_paid.raw_value / record.budget_chart_allocated.raw_value * 100) : 0) + '%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="budget_chart_paid"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="ncst_finance_chart_section">
                                    <div class="ncst_finance_chart_title">Top Expense Types</div>
                                    <div class="ncst_finance_chart_subtitle">
                                        Overview of key budget usage values
                                    </div>
                                    <div class="ncst_finance_chart_rows">
                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">
                                                <field name="top_expense_type_1"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_expense_type_1"
                                                    t-att-style="'width: 100%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="top_expense_type_1_amount"/>
                                            </div>
                                        </div>

                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">
                                                <field name="top_expense_type_2"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_expense_type_2"
                                                    t-att-style="'width: ' + (record.top_expense_type_1_amount.raw_value &amp;&amp; record.top_expense_type_1_amount.raw_value > 0 ? (record.top_expense_type_2_amount.raw_value / record.top_expense_type_1_amount.raw_value * 100) : 0) + '%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="top_expense_type_2_amount"/>
                                            </div>
                                        </div>

                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">
                                                <field name="top_expense_type_3"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_expense_type_3"
                                                    t-att-style="'width: ' + (record.top_expense_type_1_amount.raw_value &amp;&amp; record.top_expense_type_1_amount.raw_value > 0 ? (record.top_expense_type_3_amount.raw_value / record.top_expense_type_1_amount.raw_value * 100) : 0) + '%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="top_expense_type_3_amount"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="ncst_finance_chart_section">
                                    <div class="ncst_finance_chart_title">Top Spending Departments</div>
                                    <div class="ncst_finance_chart_subtitle">
                                        Overview of key budget usage values
                                    </div>
                                    <div class="ncst_finance_chart_rows">
                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">
                                                <field name="top_expense_department_1"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_department_1"
                                                    t-att-style="'width: 100%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="top_expense_department_1_amount"/>
                                            </div>
                                        </div>

                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">
                                                <field name="top_expense_department_2"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_department_2"
                                                    t-att-style="'width: ' + (record.top_expense_department_1_amount.raw_value &amp;&amp; record.top_expense_department_1_amount.raw_value > 0 ? (record.top_expense_department_2_amount.raw_value / record.top_expense_department_1_amount.raw_value * 100) : 0) + '%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="top_expense_department_2_amount"/>
                                            </div>
                                        </div>

                                        <div class="ncst_finance_chart_row">
                                            <div class="ncst_finance_chart_row_label">
                                                <field name="top_expense_department_3"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_bar_wrap">
                                                <div class="ncst_finance_chart_row_bar ncst_finance_chart_row_bar_department_3"
                                                    t-att-style="'width: ' + (record.top_expense_department_1_amount.raw_value &amp;&amp; record.top_expense_department_1_amount.raw_value > 0 ? (record.top_expense_department_3_amount.raw_value / record.top_expense_department_1_amount.raw_value * 100) : 0) + '%;'"/>
                                            </div>
                                            <div class="ncst_finance_chart_row_value">
                                                <field name="top_expense_department_3_amount"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="ncst_finance_kpi_dashboard_footer">
                                <span class="ncst_finance_kpi_footer_label">Last Updated:</span>
                                <span class="ncst_finance_kpi_footer_value">
                                    <field name="last_updated"/>
                                </span>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_finance_kpi_dashboard" model="ir.actions.act_window">
        <field name="name">Finance Dashboard</field>
        <field name="res_model">finance.kpi.dashboard</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_finance_kpi_dashboard_kanban"/>
        <field name="domain">[]</field>
        <field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Finance KPI dashboard
            </p>
            <p>
                Monitor total budget, reservations, expenses, and pending financial activities.
            </p>
        </field>
    </record>

</odoo>