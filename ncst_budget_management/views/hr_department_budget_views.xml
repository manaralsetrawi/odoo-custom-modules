<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Department Budget Overview Dashboard -->
    <record id="view_hr_department_budget_kanban" model="ir.ui.view">
        <field name="name">hr.department.budget.kanban</field>
        <field name="model">hr.department</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" quick_create="0" class="o_kanban_mobile">
                <field name="name"/>
                <field name="current_budget_amount"/>
                <field name="approved_allocation_count"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click"
                             style="
                                background: #ffffff;
                                border: 0.0625rem solid #e5eaf0;
                                border-radius: 1.5rem;
                                box-shadow: 0 0.25rem 0.9rem rgba(15, 23, 42, 0.04);
                                padding: 1.15rem;
                                margin-bottom: 0.9rem;
                                min-height: 100%;
                                display: flex;
                                flex-direction: column;
                                gap: 0.95rem;
                             ">

                            <!-- Header -->
                            <div style="
                                display: flex;
                                align-items: flex-start;
                                justify-content: space-between;
                                gap: 0.75rem;
                                flex-wrap: wrap;
                            ">
                                <div style="min-width: 0; flex: 1 1 auto;">
                                    <div style="
                                        font-size: 0.68rem;
                                        color: #94a3b8;
                                        margin-bottom: 0.35rem;
                                        text-transform: uppercase;
                                        letter-spacing: 0.05em;
                                        line-height: 1.35;
                                    ">
                                        Department Budget Overview
                                    </div>

                                    <div style="
                                        font-size: clamp(0.98rem, 0.45vw + 0.9rem, 1.28rem);
                                        font-weight: 700;
                                        color: #1e3a5f;
                                        line-height: 1.3;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Main stats -->
                            <div style="
                                display: flex;
                                flex-wrap: wrap;
                                gap: 0.8rem;
                            ">

                                <div style="
                                    flex: 1 1 13rem;
                                    min-width: 0;
                                    background: #f2f7fd;
                                    border: 0.0625rem solid #d8e6f6;
                                    border-radius: 1.1rem;
                                    padding: 0.95rem 1rem;
                                ">
                                    <div style="
                                        font-size: 0.68rem;
                                        color: #4e7cb3;
                                        margin-bottom: 0.35rem;
                                        text-transform: uppercase;
                                        letter-spacing: 0.05em;
                                        line-height: 1.35;
                                    ">
                                        Current Budget
                                    </div>

                                    <div style="
                                        font-size: clamp(1.02rem, 0.55vw + 0.95rem, 1.45rem);
                                        font-weight: 700;
                                        color: #0f4c81;
                                        line-height: 1.25;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="current_budget_amount"/>
                                    </div>
                                </div>

                                <div style="
                                    flex: 1 1 13rem;
                                    min-width: 0;
                                    background: #f8fafc;
                                    border: 0.0625rem solid #e2e8f0;
                                    border-radius: 1.1rem;
                                    padding: 0.95rem 1rem;
                                ">
                                    <div style="
                                        font-size: 0.68rem;
                                        color: #64748b;
                                        margin-bottom: 0.35rem;
                                        text-transform: uppercase;
                                        letter-spacing: 0.05em;
                                        line-height: 1.35;
                                    ">
                                        Approved Allocations
                                    </div>

                                    <div style="
                                        font-size: clamp(1.02rem, 0.55vw + 0.95rem, 1.45rem);
                                        font-weight: 700;
                                        color: #1e3a5f;
                                        line-height: 1.25;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="approved_allocation_count"/>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Read-only dashboard action -->
    <record id="action_hr_department_budget_overview" model="ir.actions.act_window">
        <field name="name">Department Budget Overview</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_hr_department_budget_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No department budget overview available
            </p>
            <p>
                Department budget information will appear here based on approved budget allocations.
            </p>
        </field>
    </record>

</odoo>