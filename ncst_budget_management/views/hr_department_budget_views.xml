<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Department Budget Overview Dashboard -->
    <record id="view_hr_department_budget_kanban" model="ir.ui.view">
        <field name="name">hr.department.budget.kanban</field>
        <field name="model">hr.department</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" quick_create="0" class="o_kanban_mobile">
                <field name="name"/>
                <field name="current_budget_amount"/>
                <field name="approved_allocation_count"/>

                <templates>
                    <t t-name="card">
                        <div style="background: transparent; border-radius: 18px; box-shadow: none; padding: 20px; margin-bottom: 10px;">

                            <!-- Header -->
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                <div>
                                    <div style="font-size: 11px; color: #9ca3af; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;">
                                        Department Budget Overview
                                    </div>
                                    <div style="font-size: 20px; font-weight: 700; color: #1e3a5f;">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Main stats -->
                            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;">

                                <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 14px; padding: 16px;">
                                    <div style="font-size: 10px; color: #059669; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
                                        Current Budget
                                    </div>
                                    <div style="font-size: 24px; font-weight: 700; color: #047857; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        <field name="current_budget_amount"/>
                                    </div>
                                </div>

                                <div style="background: #f8fafc; border: 1px solid #d9dee3; border-radius: 14px; padding: 16px;">
                                    <div style="font-size: 10px; color: #64748b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
                                        Approved Allocations
                                    </div>
                                    <div style="font-size: 24px; font-weight: 700; color: #1e3a5f;">
                                        <field name="approved_allocation_count"/>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Read-only dashboard action -->
    <record id="action_hr_department_budget_overview" model="ir.actions.act_window">
        <field name="name">Department Budget Overview</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_hr_department_budget_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No department budget overview available
            </p>
            <p>
                Department budget information will appear here based on approved budget allocations.
            </p>
        </field>
    </record>

</odoo>