<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Department Budget Overview Dashboard -->
    <record id="view_hr_department_budget_kanban" model="ir.ui.view">
        <field name="name">hr.department.budget.kanban</field>
        <field name="model">hr.department</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" quick_create="0" class="o_kanban_mobile ncst_department_budget_kanban">
                <field name="name"/>
                <field name="current_budget_amount"/>
                <field name="approved_allocation_count"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click ncst_department_budget_card">

                            <div class="ncst_department_budget_header">
                                <div class="ncst_department_budget_label">
                                    Department Budget Overview
                                </div>
                                <div class="ncst_department_budget_name">
                                    <field name="name"/>
                                </div>
                            </div>

                            <div class="ncst_department_budget_stats">
                                <div class="ncst_department_budget_stat ncst_department_budget_stat_primary">
                                    <div class="ncst_department_budget_stat_label">
                                        Current Budget
                                    </div>
                                    <div class="ncst_department_budget_stat_value">
                                        <field name="current_budget_amount"/>
                                    </div>
                                </div>

                                <div class="ncst_department_budget_stat ncst_department_budget_stat_secondary">
                                    <div class="ncst_department_budget_stat_label">
                                        Approved Allocations
                                    </div>
                                    <div class="ncst_department_budget_stat_value">
                                        <field name="approved_allocation_count"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Read-only dashboard action -->
    <record id="action_hr_department_budget_overview" model="ir.actions.act_window">
        <field name="name">Department Budget Overview</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_hr_department_budget_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No department budget overview available
            </p>
            <p>
                Department budget information will appear here based on approved budget allocations.
            </p>
        </field>
    </record>

</odoo>