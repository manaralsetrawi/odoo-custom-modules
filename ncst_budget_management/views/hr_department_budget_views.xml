<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Department Budget Overview Dashboard -->
    <record id="view_hr_department_budget_kanban" model="ir.ui.view">
        <field name="name">hr.department.budget.kanban</field>
        <field name="model">hr.department</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" quick_create="0" class="o_kanban_mobile">
                <field name="name"/>
                <field name="current_budget_amount"/>
                <field name="approved_allocation_count"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click"
                             style="
                                background: transparent;
                                border-radius: 1rem;
                                box-shadow: none;
                                padding: 1.25rem;
                                margin-bottom: 0.75rem;
                                min-height: 100%;
                                display: flex;
                                flex-direction: column;
                                gap: 1rem;
                             ">

                            <!-- Header -->
                            <div style="
                                display: flex;
                                align-items: flex-start;
                                justify-content: space-between;
                                gap: 0.75rem;
                                flex-wrap: wrap;
                            ">
                                <div style="min-width: 0; flex: 1 1 auto;">
                                    <div style="
                                        font-size: 0.75rem;
                                        color: #9ca3af;
                                        margin-bottom: 0.35rem;
                                        text-transform: uppercase;
                                        letter-spacing: 0.04em;
                                        line-height: 1.4;
                                    ">
                                        Department Budget Overview
                                    </div>

                                    <div style="
                                        font-size: clamp(1.35rem, 0.9vw + 1rem, 1.9rem);
                                        font-weight: 700;
                                        color: #1e3a5f;
                                        line-height: 1.3;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Main stats -->
                            <div style="
                                display: flex;
                                flex-wrap: wrap;
                                gap: 0.875rem;
                            ">

                                <div style="
                                    flex: 1 1 14rem;
                                    min-width: 0;
                                    background: #ecfdf5;
                                    border: 0.0625rem solid #a7f3d0;
                                    border-radius: 0.9rem;
                                    padding: 1rem;
                                ">
                                    <div style="
                                        font-size: 0.75rem;
                                        color: #059669;
                                        margin-bottom: 0.45rem;
                                        text-transform: uppercase;
                                        letter-spacing: 0.04em;
                                        line-height: 1.4;
                                    ">
                                        Current Budget
                                    </div>

                                    <div style="
                                        font-size: clamp(1.35rem, 1vw + 1rem, 2rem);
                                        font-weight: 700;
                                        color: #047857;
                                        line-height: 1.3;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="current_budget_amount"/>
                                    </div>
                                </div>

                                <div style="
                                    flex: 1 1 12rem;
                                    min-width: 0;
                                    background: #f8fafc;
                                    border: 0.0625rem solid #d9dee3;
                                    border-radius: 0.9rem;
                                    padding: 1rem;
                                ">
                                    <div style="
                                        font-size: 0.75rem;
                                        color: #64748b;
                                        margin-bottom: 0.45rem;
                                        text-transform: uppercase;
                                        letter-spacing: 0.04em;
                                        line-height: 1.4;
                                    ">
                                        Approved Allocations
                                    </div>

                                    <div style="
                                        font-size: clamp(1.35rem, 1vw + 1rem, 2rem);
                                        font-weight: 700;
                                        color: #1e3a5f;
                                        line-height: 1.3;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="approved_allocation_count"/>
                                    </div>
                                </div>

                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Read-only dashboard action -->
    <record id="action_hr_department_budget_overview" model="ir.actions.act_window">
        <field name="name">Department Budget Overview</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_hr_department_budget_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No department budget overview available
            </p>
            <p>
                Department budget information will appear here based on approved budget allocations.
            </p>
        </field>
    </record>

</odoo>