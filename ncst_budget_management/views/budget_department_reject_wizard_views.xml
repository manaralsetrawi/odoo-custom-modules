<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_department_reject_wizard_form" model="ir.ui.view">
        <field name="name">budget.department.reject.wizard.form</field>
        <field name="model">budget.department.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Budget Request">
                <sheet>
                    <group>
                        <field name="department_budget_id" readonly="1"/>
                        <field name="rejection_reason" placeholder="Enter the reason for rejection..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject"
                            string="Confirm Reject"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>