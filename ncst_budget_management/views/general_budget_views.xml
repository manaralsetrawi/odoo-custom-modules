<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard / Kanban view -->
    <record id="view_budget_general_kanban" model="ir.ui.view">
        <field name="name">budget.general.kanban</field>
        <field name="model">budget.general</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_card_content p-3">
                                <div class="mb-3">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>

                                <div class="row g-3">
                                    <div class="col-4">
                                        <div class="border rounded p-3 text-center">
                                            <div class="text-muted">Total Budget</div>
                                            <div class="fw-bold fs-4">
                                                <field name="total_amount"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="border rounded p-3 text-center">
                                            <div class="text-muted">Allocated Budget</div>
                                            <div class="fw-bold fs-4">
                                                <field name="allocated_amount"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-4">
                                        <div class="border rounded p-3 text-center">
                                            <div class="text-muted">Remaining Budget</div>
                                            <div class="fw-bold fs-4 text-success">
                                                <field name="remaining_amount"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3 text-muted">
                                    <span>Period: </span>
                                    <field name="period_start"/>
                                    <span> - </span>
                                    <field name="period_end"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Optional list view if manager wants to inspect records -->
    <record id="view_budget_general_list" model="ir.ui.view">
        <field name="name">budget.general.list</field>
        <field name="model">budget.general</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_amount"/>
                <field name="allocated_amount"/>
                <field name="remaining_amount"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_budget_general_form" model="ir.ui.view">
        <field name="name">budget.general.form</field>
        <field name="model">budget.general</field>
        <field name="arch" type="xml">
            <form string="General Budget">
                <header>
                    <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'active'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'closed' or state == 'draft'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="company_id" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="remaining_amount" readonly="1"/>
                            <field name="created_by" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard action -->
    <record id="action_budget_summary" model="ir.actions.act_window">
        <field name="name">Budget Summary</field>
        <field name="res_model">budget.general</field>
        <field name="view_mode">kanban,form,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No yearly budget pool found
            </p>
            <p>
                Create the yearly budget pool first to start allocating department budgets.
            </p>
        </field>
    </record>

</odoo>