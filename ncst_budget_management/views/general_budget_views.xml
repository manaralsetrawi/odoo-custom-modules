<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard / Kanban view -->
    <record id="view_budget_general_kanban" model="ir.ui.view">
        <field name="name">budget.general.kanban</field>
        <field name="model">budget.general</field>
        <field name="arch" type="xml">
            <kanban edit="0" delete="0" class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record"
                            style="width: 100%; max-width: 980px; margin: 0 auto;">
                            <div class="rounded-4 border bg-white shadow-sm p-3">

                                <!-- Top header -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <div class="text-muted small">Yearly Budget Pool</div>
                                        <div class="fw-bold" style="font-size: 20px;">
                                            <field name="name"/>
                                        </div>
                                    </div>
                                    <div>
                                        <field name="state"
                                            widget="badge"
                                            decoration-muted="state == 'draft'"
                                            decoration-success="state == 'active'"
                                            decoration-danger="state == 'closed'"/>
                                    </div>
                                </div>

                                <!-- Main stat cards in one row -->
                                <div class="d-flex gap-3 mb-3">
                                    <div style="flex: 1; min-width: 220px;">
                                        <div class="rounded-4 border p-3 bg-light h-100">
                                            <div class="text-muted small text-uppercase mb-1" style="white-space: nowrap;">
                                                Total Budget
                                            </div>
                                            <div class="fw-bold" style="font-size: 32px; white-space: nowrap;">
                                                <field name="total_amount"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div style="flex: 1; min-width: 220px;">
                                        <div class="rounded-4 border p-3 bg-light h-100">
                                            <div class="text-muted small text-uppercase mb-1" style="white-space: nowrap;">
                                                Allocated Budget
                                            </div>
                                            <div class="fw-bold" style="font-size: 32px; white-space: nowrap;">
                                                <field name="allocated_amount"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div style="flex: 1; min-width: 220px;">
                                        <div class="rounded-4 border p-3 h-100" style="background-color: #eaf6ec;">
                                            <div class="small text-uppercase mb-1" style="white-space: nowrap; color: #198754;">
                                                Remaining Budget
                                            </div>
                                            <div class="fw-bold" style="font-size: 32px; white-space: nowrap; color: #198754;">
                                                <field name="remaining_amount"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Bottom info -->
                                <div class="d-flex gap-3">
                                    <div style="flex: 1;">
                                        <div class="rounded-4 border p-3">
                                            <div class="text-muted small mb-1">Budget Period</div>
                                            <div class="fw-semibold">
                                                <field name="period_start"/>
                                                <span> - </span>
                                                <field name="period_end"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div style="flex: 1;">
                                        <div class="rounded-4 border p-3">
                                            <div class="text-muted small mb-1">Created By</div>
                                            <div class="fw-semibold">
                                                <field name="created_by"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view -->
    <record id="view_budget_general_list" model="ir.ui.view">
        <field name="name">budget.general.list</field>
        <field name="model">budget.general</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="total_amount"/>
                <field name="allocated_amount"/>
                <field name="remaining_amount"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-danger="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_budget_general_form" model="ir.ui.view">
        <field name="name">budget.general.form</field>
        <field name="model">budget.general</field>
        <field name="arch" type="xml">
            <form string="General Budget">
                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state in ['active', 'closed']"/>
                            <field name="period_start" readonly="state in ['active', 'closed']"/>
                            <field name="period_end" readonly="state in ['active', 'closed']"/>
                            <field name="company_id" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="remaining_amount" readonly="1"/>
                            <field name="created_by" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dashboard action -->
    <record id="action_budget_summary" model="ir.actions.act_window">
        <field name="name">Budget Summary</field>
        <field name="res_model">budget.general</field>
        <field name="view_mode">kanban,form,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No yearly budget pool found
            </p>
            <p>
                Create the yearly budget pool first to start allocating department budgets.
            </p>
        </field>
    </record>

</odoo>