<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban view -->
    <record id="view_budget_reservation_kanban" model="ir.ui.view">
        <field name="name">budget.reservation.kanban</field>
        <field name="model">budget.reservation</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="date"/>
                <field name="department_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="created_by"/>
                <field name="created_date"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click"
                            style="
                                background: transparent;
                                border-radius: 1rem;
                                padding: 1.25rem;
                                margin-bottom: 0.5rem;
                                min-height: 100%;
                                display: flex;
                                flex-direction: column;
                                gap: 1rem;
                            ">

                            <!-- Header -->
                            <div style="
                                display: flex;
                                justify-content: space-between;
                                align-items: flex-start;
                                gap: 0.75rem;
                                flex-wrap: wrap;
                            ">
                                <div style="min-width: 0; flex: 1 1 auto;">
                                    <div style="
                                        font-size: 0.8rem;
                                        color: #9ca3af;
                                        margin-bottom: 0.25rem;
                                    ">
                                        Budget Reservation
                                    </div>

                                    <div style="
                                        font-size: clamp(1.2rem, 1vw + 0.9rem, 1.6rem);
                                        font-weight: 700;
                                        color: #1e3a5f;
                                        line-height: 1.3;
                                        word-break: break-word;
                                    ">
                                        <field name="name"/>
                                    </div>
                                </div>

                                <div style="flex: 0 0 auto;">
                                    <field name="state" widget="badge"
                                        decoration-muted="state == 'draft'"
                                        decoration-warning="state == 'submitted'"
                                        decoration-info="state == 'reserved'"
                                        decoration-success="state == 'used'"
                                        decoration-danger="state == 'cancelled'"/>
                                </div>
                            </div>

                            <!-- Main info row -->
                            <div style="
                                display: flex;
                                gap: 0.75rem;
                                flex-wrap: wrap;
                            ">
                                <div style="
                                    flex: 1 1 14rem;
                                    min-width: 0;
                                    background: #f8fafc;
                                    border: 0.0625rem solid #e2e6ea;
                                    border-radius: 0.875rem;
                                    padding: 1rem;
                                ">
                                    <div style="
                                        font-size: 0.75rem;
                                        text-transform: uppercase;
                                        letter-spacing: 0.04em;
                                        color: #9ca3af;
                                        margin-bottom: 0.4rem;
                                    ">
                                        Department
                                    </div>

                                    <div style="
                                        font-size: clamp(1rem, 0.6vw + 0.9rem, 1.25rem);
                                        font-weight: 700;
                                        color: #1e3a5f;
                                        line-height: 1.4;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="department_id"/>
                                    </div>
                                </div>

                                <div style="
                                    flex: 1 1 12rem;
                                    min-width: 0;
                                    background: #ecfdf5;
                                    border: 0.0625rem solid #a7f3d0;
                                    border-radius: 0.875rem;
                                    padding: 1rem;
                                ">
                                    <div style="
                                        font-size: 0.75rem;
                                        text-transform: uppercase;
                                        letter-spacing: 0.04em;
                                        color: #059669;
                                        margin-bottom: 0.4rem;
                                    ">
                                        Amount
                                    </div>

                                    <div style="
                                        font-size: clamp(1.15rem, 0.8vw + 1rem, 1.6rem);
                                        font-weight: 700;
                                        color: #059669;
                                        line-height: 1.3;
                                        word-break: break-word;
                                    ">
                                        <field name="amount"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Meta row -->
                            <div style="
                                display: flex;
                                gap: 0.75rem;
                                flex-wrap: wrap;
                            ">
                                <div style="
                                    flex: 1 1 12rem;
                                    min-width: 0;
                                    border: 0.0625rem solid #e2e6ea;
                                    border-radius: 0.875rem;
                                    padding: 0.875rem 1rem;
                                ">
                                    <div style="
                                        font-size: 0.75rem;
                                        color: #9ca3af;
                                        margin-bottom: 0.25rem;
                                    ">
                                        Created By
                                    </div>

                                    <div style="
                                        font-size: clamp(0.95rem, 0.4vw + 0.9rem, 1.1rem);
                                        font-weight: 600;
                                        color: #1e3a5f;
                                        line-height: 1.4;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="created_by"/>
                                    </div>
                                </div>

                                <div style="
                                    flex: 1 1 12rem;
                                    min-width: 0;
                                    border: 0.0625rem solid #e2e6ea;
                                    border-radius: 0.875rem;
                                    padding: 0.875rem 1rem;
                                ">
                                    <div style="
                                        font-size: 0.75rem;
                                        color: #9ca3af;
                                        margin-bottom: 0.25rem;
                                    ">
                                        Created On
                                    </div>

                                    <div style="
                                        font-size: clamp(0.95rem, 0.4vw + 0.9rem, 1.1rem);
                                        font-weight: 600;
                                        color: #1e3a5f;
                                        line-height: 1.4;
                                        white-space: normal;
                                        word-break: break-word;
                                        overflow-wrap: anywhere;
                                    ">
                                        <field name="created_date"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view -->
    <record id="view_budget_reservation_list" model="ir.ui.view">
        <field name="name">budget.reservation.list</field>
        <field name="model">budget.reservation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="department_id"/>
                <field name="amount"/>
                <field name="request_ref"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-info="state == 'reserved'"
                       decoration-success="state == 'used'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_budget_reservation_form" model="ir.ui.view">
        <field name="name">budget.reservation.form</field>
        <field name="model">budget.reservation</field>
        <field name="arch" type="xml">
            <form string="Budget Reservation">
                <header>
                    <button name="action_submit"
                            string="Submit / Reserve"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve_reservation"
                            string="Approve Reservation"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_mark_used"
                            string="Mark as Used"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'reserved'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_cancel_reservation"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ['draft', 'submitted', 'reserved']"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reserved,used,cancelled"/>
                </header>

                <sheet>
                    <group string="Reservation Information">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="department_id" readonly="state in ['submitted', 'reserved', 'used', 'cancelled']"/>
                            <field name="department_budget_amount" readonly="1"/>
                        </group>

                        <group>
                            <field name="amount" readonly="state in ['submitted', 'reserved', 'used', 'cancelled']"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" readonly="state in ['submitted', 'reserved', 'used', 'cancelled']"/>
                    </group>

                    <group string="Tracking Information">
                        <group>
                            <field name="created_by" readonly="1"/>
                            <field name="created_date" readonly="1"/>
                            <field name="submitted_by" readonly="1" invisible="state not in ['submitted', 'reserved', 'used', 'cancelled']"/>
                            <field name="submitted_date" readonly="1" invisible="state not in ['submitted', 'reserved', 'used', 'cancelled']"/>
                            <field name="reserved_by" readonly="1" invisible="state not in ['reserved', 'used', 'cancelled']"/>
                            <field name="reserved_date" readonly="1" invisible="state not in ['reserved', 'used', 'cancelled']"/>
                        </group>

                        <group>
                            <field name="used_by" readonly="1" invisible="state != 'used'"/>
                            <field name="used_date" readonly="1" invisible="state != 'used'"/>
                            <field name="cancelled_by" readonly="1" invisible="state != 'cancelled'"/>
                            <field name="cancelled_date" readonly="1" invisible="state != 'cancelled'"/>
                            <field name="cancel_reason" readonly="1" invisible="state != 'cancelled'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">budget.reservation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first budget reservation
            </p>
            <p>
                Reserve part of an approved department budget before it is finally used or cancelled.
            </p>
        </field>
    </record>

</odoo>