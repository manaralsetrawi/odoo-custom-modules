<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view -->
    <record id="view_budget_department_tree" model="ir.ui.view">
        <field name="name">budget.department.tree</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="general_budget_id"/>
                <field name="department_id"/>
                <field name="allocated_amount"/>
                <field name="reserved_amount"/>
                <field name="used_amount"/>
                <field name="remaining_balance"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_budget_department_form" model="ir.ui.view">
        <field name="name">budget.department.form</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <form string="Department Budget">
                <header>
                    <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'active'"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'closed' or state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="general_budget_id"/>
                            <field name="department_id"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="allocated_amount"/>
                            <field name="reserved_amount" readonly="1"/>
                            <field name="used_amount" readonly="1"/>
                            <field name="remaining_balance" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Reservations">
                            <field name="reservation_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="request_ref"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_department" model="ir.actions.act_window">
        <field name="name">Department Budgets</field>
        <field name="res_model">budget.department</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>