<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard / Kanban view -->
    <record id="view_budget_department_kanban" model="ir.ui.view">
        <field name="name">budget.department.kanban</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="department_id"/>
                <field name="allocated_amount"/>
                <field name="current_department_budget"/>
                <field name="new_department_budget"/>
                <field name="general_budget_remaining"/>
                <field name="state"/>
                <field name="requested_by"/>
                <field name="approved_by"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record"
                             style="width: 100%; max-width: 950px; margin: 0 auto 16px auto; display: block;">
                            <div style="border: 1px solid #d9dee3; border-radius: 20px; background: white; box-shadow: 0 4px 14px rgba(0,0,0,0.06); padding: 20px;">

                                <!-- Header -->
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                                    <div>
                                        <div style="color: #6b7280; font-size: 13px; margin-bottom: 4px;">Department Budget Allocation</div>
                                        <div style="font-size: 20px; font-weight: 700; color: #243b53;">
                                            <field name="department_id"/>
                                        </div>
                                    </div>

                                    <div>
                                        <field name="state"
                                               widget="badge"
                                               decoration-muted="state == 'draft'"
                                               decoration-warning="state == 'submitted'"
                                               decoration-success="state == 'approved'"
                                               decoration-danger="state == 'rejected'"/>
                                    </div>
                                </div>

                                <!-- Main stat cards -->
                                <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px;">
                                    <div style="border: 1px solid #d9dee3; border-radius: 18px; background: #f8fafc; padding: 18px; min-height: 120px; display: flex; flex-direction: column; justify-content: center;">
                                        <div style="font-size: 12px; text-transform: uppercase; color: #6b7280; margin-bottom: 8px; letter-spacing: 0.4px;">
                                            Assign Amount
                                        </div>
                                        <div style="font-size: 28px; font-weight: 700; color: #243b53; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <field name="allocated_amount"/>
                                        </div>
                                    </div>

                                    <div style="border: 1px solid #d9dee3; border-radius: 18px; background: #f8fafc; padding: 18px; min-height: 120px; display: flex; flex-direction: column; justify-content: center;">
                                        <div style="font-size: 12px; text-transform: uppercase; color: #6b7280; margin-bottom: 8px; letter-spacing: 0.4px;">
                                            Current Budget
                                        </div>
                                        <div style="font-size: 28px; font-weight: 700; color: #243b53; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <field name="current_department_budget"/>
                                        </div>
                                    </div>

                                    <div style="border: 1px solid #cfe8d4; border-radius: 18px; background: #eaf6ec; padding: 18px; min-height: 120px; display: flex; flex-direction: column; justify-content: center;">
                                        <div style="font-size: 12px; text-transform: uppercase; color: #198754; margin-bottom: 8px; letter-spacing: 0.4px;">
                                            After Assignment
                                        </div>
                                        <div style="font-size: 28px; font-weight: 700; color: #198754; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <field name="new_department_budget"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Bottom details -->
                                <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px;">
                                    <div style="border: 1px solid #d9dee3; border-radius: 18px; background: white; padding: 16px;">
                                        <div style="color: #6b7280; font-size: 12px; margin-bottom: 8px;">General Budget Remaining</div>
                                        <div style="font-weight: 700; color: #243b53; font-size: 20px;">
                                            <field name="general_budget_remaining"/>
                                        </div>
                                    </div>

                                    <div style="border: 1px solid #d9dee3; border-radius: 18px; background: white; padding: 16px;">
                                        <div style="color: #6b7280; font-size: 12px; margin-bottom: 8px;">Requested By</div>
                                        <div style="font-weight: 600; color: #243b53;">
                                            <field name="requested_by"/>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view -->
    <record id="view_budget_department_list" model="ir.ui.view">
        <field name="name">budget.department.list</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="department_id" string="Department"/>
                <field name="allocated_amount" string="Assign Amount"/>
                <field name="current_department_budget" string="Current Budget"/>
                <field name="state"
                       widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_budget_department_form" model="ir.ui.view">
        <field name="name">budget.department.form</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <form string="Department Budget Allocation">
                <header>
                    <button name="action_submit"
                            string="Submit / Approve"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'rejected'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="department_id" readonly="state in ['submitted', 'approved', 'rejected']"/>
                            <field name="allocated_amount" string="Budget to Assign" readonly="state in ['submitted', 'approved', 'rejected']"/>
                        </group>
                        <group>
                            <field name="general_budget_remaining" string="General Budget Remaining" readonly="1"/>
                            <field name="current_department_budget" string="Current Department Budget" readonly="1"/>
                            <field name="new_department_budget" string="Department Budget After Assignment" readonly="1"/>
                        </group>
                    </group>

                    <!-- Hidden technical fields -->
                    <group invisible="1">
                        <field name="name"/>
                        <field name="general_budget_id"/>
                        <field name="company_id"/>
                        <field name="requested_by"/>
                        <field name="approved_by"/>
                        <field name="approval_date"/>
                        <field name="reserved_amount"/>
                        <field name="used_amount"/>
                        <field name="remaining_balance"/>
                        <field name="currency_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_department" model="ir.actions.act_window">
        <field name="name">Department Budgets</field>
        <field name="res_model">budget.department</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first department budget allocation
            </p>
            <p>
                Select a department, enter the budget amount to assign, and review the current budget values before submission or approval.
            </p>
        </field>
    </record>

</odoo>