<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="view_budget_department_list" model="ir.ui.view">
        <field name="name">budget.department.list</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="department_id"/>
                <field name="general_budget_id"/>
                <field name="allocated_amount" string="Allocated"/>
                <field name="reserved_amount" string="Reserved"/>
                <field name="used_amount" string="Used"/>
                <field name="remaining_balance" string="Remaining"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_budget_department_form" model="ir.ui.view">
        <field name="name">budget.department.form</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <form string="Department Budget">
                <header>
                    <button name="action_submit"
                            string="Submit / Approve"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state == 'draft'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="general_budget_id"/>
                            <field name="department_id"/>
                            <field name="company_id" readonly="1"/>
                            <field name="requested_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="allocated_amount"/>
                            <field name="reserved_amount" readonly="1"/>
                            <field name="used_amount" readonly="1"/>
                            <field name="remaining_balance" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Reservations">
                            <field name="reservation_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="request_ref"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_department" model="ir.actions.act_window">
        <field name="name">Department Budgets</field>
        <field name="res_model">budget.department</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first department budget
            </p>
            <p>
                Department budgets are allocation requests linked to the yearly budget pool
                and can be submitted for finance manager approval.
            </p>
        </field>
    </record>

</odoo>