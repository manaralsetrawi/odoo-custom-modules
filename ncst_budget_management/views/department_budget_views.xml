<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard / Kanban view -->
    <record id="view_budget_department_kanban" model="ir.ui.view">
        <field name="name">budget.department.kanban</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile ncst_budget_department_kanban">
                <field name="department_id"/>
                <field name="allocated_amount"/>
                <field name="current_department_budget"/>
                <field name="new_department_budget"/>
                <field name="general_budget_remaining"/>
                <field name="state"/>
                <field name="requested_by"/>
                <field name="approved_by"/>
                <field name="request_date"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click ncst_budget_department_card">

                            <div class="ncst_budget_department_header">
                                <div class="ncst_budget_department_header_main">
                                    <div class="ncst_budget_department_label">
                                        Department Budget Allocation
                                    </div>
                                    <div class="ncst_budget_department_name">
                                        <field name="department_id"/>
                                    </div>
                                </div>

                                <div class="ncst_budget_department_badge_wrap">
                                    <field name="state" widget="badge"
                                        decoration-muted="state == 'draft'"
                                        decoration-warning="state == 'submitted'"
                                        decoration-success="state == 'approved'"
                                        decoration-danger="state == 'rejected'"/>
                                </div>
                            </div>

                            <div class="ncst_budget_department_stats">
                                <div class="ncst_budget_department_stat ncst_budget_department_stat_soft">
                                    <div class="ncst_budget_department_stat_label">Assign Amt</div>
                                    <div class="ncst_budget_department_stat_value">
                                        <field name="allocated_amount"/>
                                    </div>
                                </div>

                                <div class="ncst_budget_department_stat ncst_budget_department_stat_soft">
                                    <div class="ncst_budget_department_stat_label">Current</div>
                                    <div class="ncst_budget_department_stat_value">
                                        <field name="current_department_budget"/>
                                    </div>
                                </div>

                                <div class="ncst_budget_department_stat ncst_budget_department_stat_primary">
                                    <div class="ncst_budget_department_stat_label">After</div>
                                    <div class="ncst_budget_department_stat_value">
                                        <field name="new_department_budget"/>
                                    </div>
                                </div>
                            </div>

                            <div class="ncst_budget_department_meta">
                                <div class="ncst_budget_department_meta_box">
                                    <div class="ncst_budget_department_meta_label">General Budget Remaining</div>
                                    <div class="ncst_budget_department_meta_value">
                                        <field name="general_budget_remaining"/>
                                    </div>
                                </div>

                                <div class="ncst_budget_department_meta_box">
                                    <div class="ncst_budget_department_meta_label">Requested By</div>
                                    <div class="ncst_budget_department_meta_value">
                                        <field name="requested_by"/>
                                    </div>
                                </div>

                                <div class="ncst_budget_department_meta_box">
                                    <div class="ncst_budget_department_meta_label">Request Date</div>
                                    <div class="ncst_budget_department_meta_value">
                                        <field name="request_date"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view -->
    <record id="view_budget_department_list" model="ir.ui.view">
        <field name="name">budget.department.list</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="department_id" string="Department"/>
                <field name="allocated_amount" string="Assign Amount"/>
                <field name="current_department_budget" string="Current Budget"/>
                <field name="state"
                       widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_budget_department_form" model="ir.ui.view">
        <field name="name">budget.department.form</field>
        <field name="model">budget.department</field>
        <field name="arch" type="xml">
            <form string="Department Budget Allocation">
                <header>
                    <button name="action_submit"
                            string="Submit / Approve"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'submitted'"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'rejected'"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/>
                </header>

                <sheet>
                    <!-- Request Information -->
                    <group string="Request Information">
                        <group>
                            <field name="department_id" readonly="state in ['submitted', 'approved', 'rejected']"/>
                            <field name="allocated_amount" string="Budget to Assign" readonly="state in ['submitted', 'approved', 'rejected']"/>
                            <field name="request_date" readonly="1"/>
                        </group>

                        <group>
                            <field name="general_budget_remaining" string="General Budget Remaining" readonly="1"/>
                            <field name="current_department_budget" string="Current Department Budget" readonly="1"/>
                            <field name="new_department_budget" string="Department Budget After Assignment" readonly="1"/>
                        </group>
                    </group>

                    <!-- Approval Information -->
                    <group string="Approval Information" invisible="state != 'approved'">
                        <group>
                            <field name="approved_by" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>

                    <!-- Rejection Information -->
                    <group string="Rejection Information" invisible="state != 'rejected'">
                        <group>
                            <field name="rejected_by" readonly="1"/>
                            <field name="rejection_date" readonly="1"/>
                            <field name="rejection_reason" readonly="1"/>
                        </group>
                    </group>

                    <!-- Hidden technical fields -->
                    <group invisible="1">
                        <field name="name"/>
                        <field name="general_budget_id"/>
                        <field name="company_id"/>
                        <field name="requested_by"/>
                        <field name="reserved_amount"/>
                        <field name="used_amount"/>
                        <field name="remaining_balance"/>
                        <field name="currency_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_budget_department" model="ir.actions.act_window">
        <field name="name">Department Budgets</field>
        <field name="res_model">budget.department</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first department budget allocation
            </p>
            <p>
                Select a department, enter the budget amount to assign, and review the current budget values before submission or approval.
            </p>
        </field>
    </record>

</odoo>