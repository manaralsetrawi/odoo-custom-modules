<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_purchase_request_reject_wizard_form" model="ir.ui.view">
            <field name="name">purchase.request.reject.wizard.form</field>
            <field name="model">purchase.request.reject.wizard</field>
            <field name="arch" type="xml">
                <form string="Reject Purchase Request">
                    <group>
                        <field name="purchase_request_id" readonly="1"/>
                        <field name="rejection_reason" placeholder="Enter rejection reason..."/>
                    </group>
                    <footer>
                        <button name="action_confirm_reject"
                                type="object"
                                string="Confirm Rejection"
                                class="btn-danger"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>