<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_purchase_request_list" model="ir.ui.view">
            <field name="name">purchase.request.list</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="department_id"/>
                    <field name="requester_category"/>
                    <field name="required_date"/>
                    <field name="amount_total"/>

                    <field name="state"
                            widget="badge"
                            decoration-info="state == 'draft'"
                            decoration-warning="state in ('waiting_coordinator', 'waiting_principal', 'waiting_director', 'waiting_budget')"
                            decoration-success="state == 'approved'"
                            decoration-danger="state == 'rejected'"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_purchase_request_form" model="ir.ui.view">
            <field name="name">purchase.request.form</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <form string="Purchase Request">

                    <header>
                        <button name="action_submit"
                                type="object"
                                string="Submit"
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <button name="action_coordinator_approve"
                                type="object"
                                string="Coordinator Approve"
                                class="btn-success"
                                invisible="state != 'waiting_coordinator'"/>

                        <button name="action_principal_approve"
                                type="object"
                                string="Principal / Vice Principal Approve"
                                class="btn-success"
                                invisible="state != 'waiting_principal'"/>

                        <button name="action_director_approve"
                                type="object"
                                string="Department Director Approve"
                                class="btn-success"
                                invisible="state != 'waiting_director'"/>

                        <button name="action_verify_budget"
                                type="object"
                                string="Verify Budget"
                                class="btn-primary"
                                invisible="state != 'waiting_budget'"/>

                        <button name="action_reject"
                                type="object"
                                string="Reject"
                                class="btn-danger"
                                invisible="state not in ('waiting_coordinator','waiting_principal','waiting_director','waiting_budget')"/>
                        
                        <field name="state"
                                widget="statusbar"
                                statusbar_visible="draft,waiting_coordinator,waiting_principal,waiting_budget,approved,rejected"
                                invisible="requester_category != 'teacher'"/>

                        <field name="state"
                                widget="statusbar"
                                statusbar_visible="draft,waiting_director,waiting_budget,approved,rejected"
                                invisible="requester_category != 'admin'"/>
                        
                        <field name="state"
                                widget="statusbar"
                                statusbar_visible="draft,approved,rejected"
                                invisible="requester_category in ('teacher','admin')"/>

                    </header>

                    <sheet>

                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>

                        <group string="Purchase Request Information">
                            <group>
                                <field name="requester_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="requester_category" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="required_date" readonly="state != 'draft'"/>
                                <field name="amount_total" readonly="1"/>
                            </group>
                        </group>

                        <group string="Request Reason">
                            <field name="request_reason" readonly="state != 'draft'"/>
                        </group>

                        <notebook>
                            <page string="Request Lines">
                                <field name="line_ids" readonly="state != 'draft'">
                                    <list editable="bottom" delete="state == 'draft'">
                                        <field name="product_id" readonly="parent.state != 'draft'"/>
                                        <!-- <field name="product_description"/> -->
                                        <field name="specifications" readonly="parent.state != 'draft'"/>
                                        <field name="quantity" readonly="parent.state != 'draft'"/>
                                        <field name="estimated_unit_price" readonly="parent.state != 'draft'"/>
                                        <field name="subtotal" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                        <group string="Approval Information" 
                               invisible="not coordinator_approved_by and not principal_approved_by and not director_approved_by">
                            
                            <group invisible="not coordinator_approved_by">
                                <field name="coordinator_approved_by" readonly="1"/>
                                <field name="coordinator_approved_date" readonly="1"/>
                            </group>
                            
                            <group invisible="not principal_approved_by">
                                <field name="principal_approved_by" readonly="1"/>
                                <field name="principal_approved_date" readonly="1"/>
                            </group>
                            
                            <group invisible="not director_approved_by">
                                <field name="director_approved_by" readonly="1"/>
                                <field name="director_approved_date" readonly="1"/>
                            </group>
                        </group>

                        <group string="Budget Verification">
                            <group>
                                <field name="budget_available_amount"/>
                                <field name="budget_verified" readonly="1"/>
                            </group>
                            <group>
                                <field name="budget_verified_by" readonly="1"/>
                                <field name="budget_verified_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="budget_note"/>
                            </group>
                        </group>

                        <group string="Rejection Information" invisible="not rejection_reason">
                            <field name="rejection_reason" readonly="1"/>
                        </group>

                    </sheet>

                    <chatter/>

                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_purchase_request" model="ir.actions.act_window">
            <field name="name">Purchase Requests</field>
            <field name="res_model">purchase.request</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>