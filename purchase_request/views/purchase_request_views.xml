<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_purchase_request_list" model="ir.ui.view">
            <field name="name">purchase.request.list</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="department_id"/>
                    <field name="requester_category"/>
                    <field name="required_date"/>
                    <field name="amount_total"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_purchase_request_form" model="ir.ui.view">
            <field name="name">purchase.request.form</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <form string="Purchase Request">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="requester_id"/>
                                <field name="department_id" readonly="1"/>
                                <field name="requester_category"/>
                            </group>
                            <group>
                                <field name="required_date"/>
                                <field name="state" readonly="1"/>
                                <field name="amount_total" readonly="1"/>
                            </group>
                        </group>

                        <group string="Reason">
                            <field name="request_reason"/>
                        </group>

                        <notebook>
                            <page string="Request Lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="product_description"/>
                                        <field name="specifications"/>
                                        <field name="quantity"/>
                                        <field name="estimated_unit_price"/>
                                        <field name="subtotal" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                        <group string="Approval Information">
                            <group>
                                <field name="coordinator_approved_by" readonly="1"/>
                                <field name="coordinator_approved_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="principal_approved_by" readonly="1"/>
                                <field name="principal_approved_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="director_approved_by" readonly="1"/>
                                <field name="director_approved_date" readonly="1"/>
                            </group>
                        </group>

                        <group string="Budget Verification">
                            <group>
                                <field name="budget_available_amount"/>
                                <field name="budget_verified" readonly="1"/>
                            </group>
                            <group>
                                <field name="budget_verified_by" readonly="1"/>
                                <field name="budget_verified_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="budget_note"/>
                            </group>
                        </group>

                        <group string="Rejection Information">
                            <field name="rejection_reason"/>
                        </group>

                        <div class="oe_chatter">
                            <field name="message_follower_ids"/>
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_purchase_request" model="ir.actions.act_window">
            <field name="name">Purchase Requests</field>
            <field name="res_model">purchase.request</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>