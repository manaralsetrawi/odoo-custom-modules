<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_purchase_request_budget_wizard_form" model="ir.ui.view">
            <field name="name">purchase.request.budget.wizard.form</field>
            <field name="model">purchase.request.budget.wizard</field>
            <field name="arch" type="xml">
                <form string="Verify Budget">
                    <group>
                        <field name="purchase_request_id" readonly="1"/>
                        <field name="available_budget"/>
                        <field name="budget_note"/>
                    </group>
                    <footer>
                        <button name="action_confirm_budget_verification"
                                type="object"
                                string="Confirm"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>