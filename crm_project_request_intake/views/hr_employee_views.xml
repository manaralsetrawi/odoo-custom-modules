<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_employee_form_inherit_project_assignments" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.project.assignments</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Project Assignments">
                    <field name="project_assignment_ids" readonly="1">
                        <list>
                            <field name="lead_id"/>
                            <field name="team_id"/>
                            <field name="planned_start_date"/>
                            <field name="planned_end_date"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>