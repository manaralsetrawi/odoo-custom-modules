<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_hr_employee_form_inherit_project_assignments" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.project.assignments</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/notebook" position="inside">
                <page string="Project Assignments">
                    <group>
                        <group>
                            <field name="monthly_capacity"/>
                            <field name="remaining_capacity" readonly="1"/>
                        </group>
                    </group>

                    <field name="assignment_line_ids" readonly="1">
                        <list>
                            <field name="assignment_id"/>
                            <field name="employee_team_id"/>
                            <field name="workload_percentage"/>
                            <field name="monthly_reserved_percentage"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>