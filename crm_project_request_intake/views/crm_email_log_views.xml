<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_crm_email_log_list" model="ir.ui.view">
        <field name="name">crm.email.log.list</field>
        <field name="model">crm.email.log</field>
        <field name="arch" type="xml">
            <list string="Email Logs">
                <field name="lead_id"/>
                <field name="email_date"/>
                <field name="direction"/>
                <field name="email_type"/>
                <field name="subject"/>
                <field name="sender_email"/>
                <field name="recipient_email"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_crm_email_log_form" model="ir.ui.view">
        <field name="name">crm.email.log.form</field>
        <field name="model">crm.email.log</field>
        <field name="arch" type="xml">
            <form string="Email Log">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="email_date"/>
                            <field name="direction"/>
                            <field name="email_type"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="sender_email"/>
                            <field name="recipient_email"/>
                        </group>
                    </group>

                    <group>
                        <field name="body_preview"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_crm_email_log_search" model="ir.ui.view">
        <field name="name">crm.email.log.search</field>
        <field name="model">crm.email.log</field>
        <field name="arch" type="xml">
            <search string="Search Email Logs">
                <field name="lead_id"/>
                <field name="subject"/>
                <field name="sender_email"/>
                <field name="recipient_email"/>
                <field name="email_type"/>
                <field name="direction"/>

                <group expand="0" string="Group By">
                    <filter string="Lead / Opportunity" name="group_by_lead" context="{'group_by': 'lead_id'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'email_type'}"/>
                    <filter string="Direction" name="group_by_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'email_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_crm_email_log" model="ir.actions.act_window">
        <field name="name">Email Logs</field>
        <field name="res_model">crm.email.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_crm_email_log_search"/>
    </record>

</odoo>