<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Kanban Card View -->
    <record id="view_crm_client_segment_kanban" model="ir.ui.view">
        <field name="name">crm.client.segment.kanban</field>
        <field name="model">crm.client.segment</field>
        <field name="arch" type="xml">
            <kanban class="o_cpri_client_segment_kanban_page">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>

                <templates>
                    <t t-name="card">
                        <div class="o_cpri_client_segment_card oe_kanban_global_click">
                            <div class="o_cpri_client_segment_card_header">
                                <div>
                                    <div class="o_cpri_client_segment_card_title">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_cpri_client_segment_card_code">
                                        Code: <field name="code"/>
                                    </div>
                                </div>

                                <span t-if="record.active.raw_value"
                                      class="o_cpri_client_segment_active_badge">
                                    Active
                                </span>
                                <span t-if="!record.active.raw_value"
                                      class="o_cpri_client_segment_archived_badge">
                                    Archived
                                </span>
                            </div>

                            <div class="o_cpri_client_segment_card_description">
                                <field name="description"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_crm_client_segment_list" model="ir.ui.view">
        <field name="name">crm.client.segment.list</field>
        <field name="model">crm.client.segment</field>
        <field name="arch" type="xml">
            <list class="o_cpri_client_segment_list_page">
                <field name="name" string="Segment Name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_crm_client_segment_form" model="ir.ui.view">
        <field name="name">crm.client.segment.form</field>
        <field name="model">crm.client.segment</field>
        <field name="arch" type="xml">
            <form string="Client Segment" class="o_cpri_client_segment_form_page">
                <sheet>
                    <div class="o_cpri_client_segment_form_header">
                        <h2>
                            <field name="name" placeholder="e.g. Education Institution"/>
                        </h2>
                        <p>Classify clients by organization type for project request review.</p>
                    </div>

                    <group class="o_cpri_client_segment_form_card" string="Segment Details">
                        <group>
                            <field name="code" placeholder="e.g. EDU"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <group class="o_cpri_client_segment_form_card o_cpri_client_segment_form_description"
                           string="Description">
                        <field name="description"
                               placeholder="Write a short description for this client segment..."
                               nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_crm_client_segment_search" model="ir.ui.view">
        <field name="name">crm.client.segment.search</field>
        <field name="model">crm.client.segment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active_segments" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived_segments" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_crm_client_segment" model="ir.actions.act_window">
        <field name="name">Client Segments</field>
        <field name="res_model">crm.client.segment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_crm_client_segment_search"/>
        <field name="context">{'search_default_active_segments': 1}</field>
        <field name="views" eval="[
            (ref('view_crm_client_segment_kanban'), 'kanban'),
            (ref('view_crm_client_segment_list'), 'list'),
            (ref('view_crm_client_segment_form'), 'form')
        ]"/>
    </record>

</odoo>