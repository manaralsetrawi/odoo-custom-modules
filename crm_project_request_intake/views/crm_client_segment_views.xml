<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_crm_client_segment_tree" model="ir.ui.view">
        <field name="name">crm.client.segment.tree</field>
        <field name="model">crm.client.segment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_crm_client_segment_form" model="ir.ui.view">
        <field name="name">crm.client.segment.form</field>
        <field name="model">crm.client.segment</field>
        <field name="arch" type="xml">
            <form string="Client Segment">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_crm_client_segment" model="ir.actions.act_window">
        <field name="name">Client Segments</field>
        <field name="res_model">crm.client.segment</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>