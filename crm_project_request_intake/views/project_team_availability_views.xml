<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_project_team_availability_list" model="ir.ui.view">
        <field name="name">project.team.availability.list</field>
        <field name="model">project.team.availability</field>
        <field name="arch" type="xml">
            <list>
                <field name="team_id"/>
                <field name="month"/>
                <field name="year"/>
                <field name="availability_status"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_project_team_availability_form" model="ir.ui.view">
        <field name="name">project.team.availability.form</field>
        <field name="model">project.team.availability</field>
        <field name="arch" type="xml">
            <form string="Team Availability">
                <sheet>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="month"/>
                            <field name="year"/>
                        </group>
                        <group>
                            <field name="availability_status"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_team_availability" model="ir.actions.act_window">
        <field name="name">Team Availability</field>
        <field name="res_model">project.team.availability</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>