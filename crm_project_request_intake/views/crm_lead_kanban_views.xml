<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_lead_project_request_kanban_cards" model="ir.ui.view">
        <field name="name">crm.lead.project.request.kanban.cards</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">

            <xpath expr="//kanban" position="attributes">
                <attribute name="class">ncst_pr_intake_kanban_root</attribute>
            </xpath>

            <xpath expr="//templates/t[@t-name='card']" position="replace">
                <t t-name="card">
                    <div class="ncst_pr_intake_card">

                        <div class="ncst_pr_intake_card_header">

                            <div class="ncst_pr_intake_icon">
                                <i class="fa fa-lightbulb-o"/>
                            </div>

                            <div class="ncst_pr_intake_title_area">
                                <strong class="ncst_pr_intake_title">
                                    <field name="name"/>
                                </strong>

                                <div class="ncst_pr_intake_contact">
                                    <i class="fa fa-envelope-o"/>
                                    <field name="email_from"/>
                                </div>

                                <div class="ncst_pr_intake_contact">
                                    <i class="fa fa-phone"/>
                                    <field name="phone"/>
                                </div>
                            </div>

                            <span class="ncst_pr_intake_badge">
                                <field name="intake_state"/>
                            </span>

                        </div>

                        <div class="ncst_pr_intake_tag">
                            <i class="fa fa-tag"/>
                            <field name="request_type"/>
                        </div>

                        <div class="ncst_pr_intake_body">

                            <div class="ncst_pr_intake_info_line">
                                <i class="fa fa-building-o"/>
                                <span>
                                    <field name="intake_company_name"/>
                                </span>
                            </div>

                            <div class="ncst_pr_intake_info_line">
                                <i class="fa fa-calendar"/>
                                <span>
                                    <field name="create_date"/>
                                </span>
                            </div>

                            <div class="ncst_pr_intake_info_line">
                                <i class="fa fa-user-circle-o"/>
                                <span>
                                    <field name="user_id"/>
                                </span>
                            </div>

                        </div>

                        <div class="ncst_pr_intake_footer">
                            <div class="ncst_pr_intake_icons">
                                <i class="fa fa-star-o"/>
                                <i class="fa fa-comments-o"/>
                            </div>

                            <button type="open" class="btn ncst_pr_intake_view_btn">
                                View
                            </button>
                        </div>

                    </div>
                </t>
            </xpath>

        </field>
    </record>

</odoo>