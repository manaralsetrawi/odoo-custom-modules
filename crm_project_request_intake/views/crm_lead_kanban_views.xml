<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_lead_project_request_kanban_cards" model="ir.ui.view">
        <field name="name">crm.lead.project.request.kanban.cards</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">

            <xpath expr="//kanban" position="inside">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email_from"/>
                <field name="phone"/>
                <field name="priority"/>
                <field name="request_type"/>
                <field name="intake_state"/>
                <field name="intake_company_name"/>
                <field name="intake_requested_budget"/>
                <field name="intake_requested_duration"/>
                <field name="create_date"/>
                <field name="user_id"/>
            </xpath>

            <xpath expr="//kanban" position="attributes">
                <attribute name="class">ncst_pr_intake_kanban_root</attribute>
            </xpath>

                <xpath expr="//templates/t[@t-name='kanban-box']" position="replace">                
                <t t-name="kanban-box">
                    <div class="ncst_pr_intake_card">

                        <div class="ncst_pr_intake_top">
                            <div class="ncst_pr_intake_icon">
                                <i class="fa fa-folder-open-o"/>
                            </div>

                            <div class="ncst_pr_intake_title_wrap">
                                <strong class="ncst_pr_intake_title">
                                    <field name="name"/>
                                </strong>
                                <div class="ncst_pr_intake_client">
                                    <field name="contact_name"/>
                                </div>
                            </div>

                            <span class="ncst_pr_intake_status">
                                <field name="intake_state"/>
                            </span>
                        </div>

                        <div class="ncst_pr_intake_chips">
                            <span class="ncst_pr_intake_chip ncst_pr_intake_chip_type">
                                <i class="fa fa-tag"/>
                                <field name="request_type"/>
                            </span>

                            <span class="ncst_pr_intake_chip">
                                <i class="fa fa-star"/>
                                <field name="priority" widget="priority"/>
                            </span>
                        </div>

                        <div class="ncst_pr_intake_details">

                            <div class="ncst_pr_intake_line">
                                <i class="fa fa-envelope-o"/>
                                <span><field name="email_from"/></span>
                            </div>

                            <div class="ncst_pr_intake_line">
                                <i class="fa fa-phone"/>
                                <span><field name="phone"/></span>
                            </div>

                            <div class="ncst_pr_intake_line">
                                <i class="fa fa-building-o"/>
                                <span><field name="intake_company_name"/></span>
                            </div>

                            <div class="ncst_pr_intake_line">
                                <i class="fa fa-money"/>
                                <span>Budget:</span>
                                <strong><field name="intake_requested_budget"/></strong>
                            </div>

                            <div class="ncst_pr_intake_line">
                                <i class="fa fa-hourglass-half"/>
                                <span>Duration:</span>
                                <strong><field name="intake_requested_duration"/></strong>
                            </div>

                        </div>

                        <div class="ncst_pr_intake_bottom">
                            <div class="ncst_pr_intake_meta">
                                <i class="fa fa-user-circle-o"/>
                                <field name="user_id"/>
                            </div>

                            <button type="open"
                                    name="open_record"
                                    class="btn ncst_pr_intake_view_btn">
                                View
                            </button>
                        </div>

                    </div>
                </t>
            </xpath>

        </field>
    </record>

</odoo>