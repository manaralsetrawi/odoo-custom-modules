<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_project_assignment_team_list" model="ir.ui.view">
        <field name="name">project.assignment.team.list</field>
        <field name="model">project.assignment.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_type_ids" widget="many2many_tags"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_project_assignment_team_form" model="ir.ui.view">
        <field name="name">project.assignment.team.form</field>
        <field name="model">project.assignment.team</field>
        <field name="arch" type="xml">
            <form string="Project Assignment Team">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="project_type_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Team Members">
                            <field name="member_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_assignment_team" model="ir.actions.act_window">
        <field name="name">Project Teams</field>
        <field name="res_model">project.assignment.team</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>