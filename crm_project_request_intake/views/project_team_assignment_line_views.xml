<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_project_team_assignment_line_list" model="ir.ui.view">
        <field name="name">project.team.assignment.line.list</field>
        <field name="model">project.team.assignment.line</field>
        <field name="arch" type="xml">
            <list string="Resource Allocations">
                <field name="employee_id"/>
                <field name="employee_team_id"/>
                <field name="assignment_id"/>
                <field name="workload_percentage"/>
                <field name="monthly_reserved_percentage"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_project_team_assignment_line_search" model="ir.ui.view">
        <field name="name">project.team.assignment.line.search</field>
        <field name="model">project.team.assignment.line</field>
        <field name="arch" type="xml">
            <search string="Search Resource Allocations">
                <field name="employee_id"/>
                <field name="employee_team_id"/>
                <field name="assignment_id"/>

                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Team" name="group_by_team" context="{'group_by': 'employee_team_id'}"/>
                    <filter string="Assignment" name="group_by_assignment" context="{'group_by': 'assignment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_team_assignment_line" model="ir.actions.act_window">
        <field name="name">Resource Allocations</field>
        <field name="res_model">project.team.assignment.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_team_assignment_line_search"/>
    </record>

</odoo>