<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">project.request.reject.wizard.form</field>
        <field name="model">project.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Project Request">
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="rejection_category"/>
                    <field name="rejection_reason"/>
                </group>
                <footer>
                    <button name="action_confirm_rejection"
                            string="Confirm Rejection"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>