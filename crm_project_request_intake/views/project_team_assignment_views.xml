<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Kanban Card View -->
    <record id="view_project_team_assignment_kanban" model="ir.ui.view">
        <field name="name">project.team.assignment.kanban</field>
        <field name="model">project.team.assignment</field>
        <field name="arch" type="xml">
            <kanban class="o_cpri_team_assignment_kanban_page">
                <field name="lead_id"/>
                <field name="team_id"/>
                <field name="employee_ids"/>
                <field name="planned_start_date"/>
                <field name="planned_end_date"/>

                <templates>
                    <t t-name="card">
                        <div class="o_cpri_team_assignment_card oe_kanban_global_click">
                            <div class="o_cpri_team_assignment_header">
                                <div>
                                    <div class="o_cpri_team_assignment_title">
                                        <field name="lead_id"/>
                                    </div>
                                    <div class="o_cpri_team_assignment_team">
                                        <i class="fa fa-users"/>
                                        <field name="team_id"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_cpri_team_assignment_dates">
                                <div>
                                    <span>Start</span>
                                    <strong><field name="planned_start_date"/></strong>
                                </div>
                                <div>
                                    <span>End</span>
                                    <strong><field name="planned_end_date"/></strong>
                                </div>
                            </div>

                            <div class="o_cpri_team_assignment_members">
                                <span>Assigned Employees</span>
                                <field name="employee_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_project_team_assignment_list" model="ir.ui.view">
        <field name="name">project.team.assignment.list</field>
        <field name="model">project.team.assignment</field>
        <field name="arch" type="xml">
            <list string="Project Assignments" class="o_cpri_team_assignment_list_page">
                <field name="lead_id"/>
                <field name="team_id"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="planned_start_date"/>
                <field name="planned_end_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_project_team_assignment_form" model="ir.ui.view">
        <field name="name">project.team.assignment.form</field>
        <field name="model">project.team.assignment</field>
        <field name="arch" type="xml">
            <form string="Project Assignment" class="o_cpri_team_assignment_form_page">
                <sheet>
                    <div class="o_cpri_team_assignment_form_header">
                        <h2>
                            <field name="lead_id"/>
                        </h2>
                        <p>Review the assigned team, project duration, and employees reserved for this project.</p>
                    </div>

                    <group class="o_cpri_team_assignment_form_card" string="Assignment Overview">
                        <group>
                            <field name="lead_id"/>
                            <field name="team_id"/>
                        </group>

                        <group>
                            <field name="planned_start_date"/>
                            <field name="planned_end_date"/>
                        </group>
                    </group>

                    <group class="o_cpri_team_assignment_form_card" string="Assigned Employees">
                        <field name="employee_ids"
                               widget="many2many_tags"
                               nolabel="1"/>
                    </group>

                    <group class="o_cpri_team_assignment_form_card o_cpri_team_assignment_notes" string="Notes">
                        <field name="notes"
                               nolabel="1"
                               placeholder="Write assignment notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_project_team_assignment_search" model="ir.ui.view">
        <field name="name">project.team.assignment.search</field>
        <field name="model">project.team.assignment</field>
        <field name="arch" type="xml">
            <search string="Search Project Assignments">
                <field name="lead_id"/>
                <field name="team_id"/>
                <field name="employee_ids"/>

                <group expand="0" string="Group By">
                    <filter string="Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Project" name="group_by_lead" context="{'group_by': 'lead_id'}"/>
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_team_assignment" model="ir.actions.act_window">
        <field name="name">Project Assignments</field>
        <field name="res_model">project.team.assignment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_project_team_assignment_search"/>
        <field name="views" eval="[
            (ref('view_project_team_assignment_kanban'), 'kanban'),
            (ref('view_project_team_assignment_list'), 'list'),
            (ref('view_project_team_assignment_form'), 'form')
        ]"/>
    </record>

</odoo>