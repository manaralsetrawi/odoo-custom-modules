<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_project_team_assignment_list" model="ir.ui.view">
        <field name="name">project.team.assignment.list</field>
        <field name="model">project.team.assignment</field>
        <field name="arch" type="xml">
            <list string="Project Assignments">
                <field name="lead_id"/>
                <field name="team_id"/>
                <field name="planned_start_date"/>
                <field name="planned_end_date"/>
                <field name="estimated_duration_months"/>
                <field name="workload_percentage"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_project_team_assignment_form" model="ir.ui.view">
        <field name="name">project.team.assignment.form</field>
        <field name="model">project.team.assignment</field>
        <field name="arch" type="xml">
            <form string="Team Assignment">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="team_id"/>
                            <field name="planned_start_date"/>
                            <field name="planned_end_date"/>
                        </group>
                        <group>
                            <field name="estimated_duration_months"/>
                            <field name="workload_percentage" readonly="1"/>
                            <field name="assigned_employee_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>

                    <group string="Assigned Resources">
                        <field name="assignment_line_ids" readonly="1">
                            <list>
                                <field name="employee_id"/>
                                <field name="employee_team_id"/>
                                <field name="workload_percentage"/>
                                <field name="monthly_reserved_percentage"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>

                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_project_team_assignment_search" model="ir.ui.view">
        <field name="name">project.team.assignment.search</field>
        <field name="model">project.team.assignment</field>
        <field name="arch" type="xml">
            <search string="Search Project Assignments">
                <field name="lead_id"/>
                <field name="team_id"/>

                <group expand="0" string="Group By">
                    <filter string="Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Project" name="group_by_lead" context="{'group_by': 'lead_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_team_assignment" model="ir.actions.act_window">
        <field name="name">Project Assignments</field>
        <field name="res_model">project.team.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_project_team_assignment_search"/>
    </record>

</odoo>