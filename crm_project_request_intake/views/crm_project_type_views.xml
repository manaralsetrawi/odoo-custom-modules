<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Kanban Card View -->
    <record id="view_crm_project_type_kanban" model="ir.ui.view">
        <field name="name">crm.project.type.kanban</field>
        <field name="model">crm.project.type</field>
        <field name="arch" type="xml">
            <kanban class="o_cpri_project_type_kanban_page">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>

                <templates>
                    <t t-name="card">
                        <div class="o_cpri_project_type_card oe_kanban_global_click">
                            <div class="o_cpri_project_type_card_header">
                                <div>
                                    <div class="o_cpri_project_type_card_title">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_cpri_project_type_card_code">
                                        Code: <field name="code"/>
                                    </div>
                                </div>

                                <span t-if="record.active.raw_value"
                                      class="o_cpri_project_type_active_badge">
                                    Active
                                </span>
                                <span t-if="!record.active.raw_value"
                                      class="o_cpri_project_type_archived_badge">
                                    Archived
                                </span>
                            </div>

                            <div class="o_cpri_project_type_card_description">
                                <field name="description"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_crm_project_type_list" model="ir.ui.view">
        <field name="name">crm.project.type.list</field>
        <field name="model">crm.project.type</field>
        <field name="arch" type="xml">
            <list class="o_cpri_project_type_list_page">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_crm_project_type_form" model="ir.ui.view">
        <field name="name">crm.project.type.form</field>
        <field name="model">crm.project.type</field>
        <field name="arch" type="xml">
            <form string="Project Type" class="o_cpri_project_type_form_page">
                <sheet>

                    <div class="o_cpri_project_type_form_header">
                        <span class="o_cpri_project_type_label">Project Classification</span>

                        <h2>
                            <field name="name" placeholder="e.g. AI Automation"/>
                        </h2>

                        <p>Define project categories used during project request review and team assignment.</p>
                    </div>

                    <group class="o_cpri_project_type_section" string="Project Type Details">
                        <group>
                            <field name="code" placeholder="e.g. AI"/>
                            <field name="active" string="Status" widget="boolean_toggle" class="o_cpri_project_type_status_toggle"/>
                        </group>
                    </group>

                    <group class="o_cpri_project_type_section o_cpri_project_type_description"
                        string="Description">
                        <field name="description"
                            placeholder="Write a short description for this project type..."
                            nolabel="1"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_crm_project_type_search" model="ir.ui.view">
        <field name="name">crm.project.type.search</field>
        <field name="model">crm.project.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active_project_types" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived_project_types" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_crm_project_type" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">crm.project.type</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_crm_project_type_search"/>
        <field name="context">{'search_default_active_project_types': 1}</field>
        <field name="views" eval="[
            (ref('view_crm_project_type_kanban'), 'kanban'),
            (ref('view_crm_project_type_list'), 'list'),
            (ref('view_crm_project_type_form'), 'form')
        ]"/>
    </record>

</odoo>