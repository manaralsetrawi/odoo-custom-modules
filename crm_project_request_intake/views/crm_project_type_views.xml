<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_crm_project_type_list" model="ir.ui.view">
        <field name="name">crm.project.type.list</field>
        <field name="model">crm.project.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_crm_project_type_form" model="ir.ui.view">
        <field name="name">crm.project.type.form</field>
        <field name="model">crm.project.type</field>
        <field name="arch" type="xml">
            <form string="Project Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_crm_project_type" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">crm.project.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>