<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_lead_form_project_request_intake" model="ir.ui.view">
        <field name="name">crm.lead.form.project.request.intake</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm_workflow_custom.view_crm_lead_form_workflow_custom"/>
        <field name="arch" type="xml">

            <!-- Hidden helper fields + smart button -->
            <xpath expr="//form/sheet" position="inside">
                <field name="intake_state" invisible="1"/>
                <field name="intake_is_project_request" invisible="1"/>
                <field name="assignment_count" invisible="1"/>

                <div class="oe_button_box" name="button_box">
                    <button name="action_view_project_assignments"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users"
                            invisible="type != 'opportunity'">
                        <field name="assignment_count" string="Assignments" widget="statinfo"/>
                    </button>
                    <button name="action_view_email_logs"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-envelope">
                        <field name="email_log_count" string="Email Logs" widget="statinfo"/>
                    </button>
                </div>

                <field name="email_log_count" invisible="1"/>
            </xpath>

            <!-- Show request type after title -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="request_type" readonly="1"/>
            </xpath>

            <!-- Contact name readonly -->
            <xpath expr="//field[@name='contact_name']" position="replace">
                <field name="contact_name" readonly="1"/>
            </xpath>

            <!-- Email readonly -->
            <xpath expr="//field[@name='email_from']" position="replace">
                <field name="email_from" readonly="1"/>
            </xpath>

            <!-- Phone readonly -->
            <xpath expr="//field[@name='phone']" position="replace">
                <field name="phone" readonly="1"/>
            </xpath>

            <!-- Hide unwanted standard fields for project requests -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_name']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='street2']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//label[@for='street']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='lang_id']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='email_cc']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='priority']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='title']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='function']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <!-- Hide Salesperson and Sales Team -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="invisible">request_type == 'project_request'</attribute>
            </xpath>

            <!-- Hide workflow button for leads -->
            <xpath expr="//button[@name='action_start_analysis']" position="attributes">
                <attribute name="invisible">type == 'lead' or not show_start_analysis_btn</attribute>
            </xpath>

            <!-- Header buttons -->
            <xpath expr="//form/header" position="inside">
                <button name="action_intake_start_review"
                        string="Start Review"
                        type="object"
                        class="btn-primary"
                        groups="crm_workflow_custom.group_crm_workflow_manager"
                        invisible="type != 'lead' or request_type != 'project_request' or intake_state != 'submitted'"/>

                <button name="action_intake_approve_request"
                        string="Approve Request"
                        type="object"
                        class="btn-success"
                        groups="crm_workflow_custom.group_crm_workflow_manager"
                        invisible="type != 'lead' or request_type != 'project_request' or intake_state != 'under_review'"/>

                <button name="action_intake_open_reject_wizard"
                        string="Reject Request"
                        type="object"
                        class="btn-danger"
                        groups="crm_workflow_custom.group_crm_workflow_manager"
                        invisible="type != 'lead' or request_type != 'project_request' or intake_state != 'under_review'"/>
            </xpath>

            <!-- Notebook tabs -->
            <xpath expr="//form/sheet/notebook" position="inside">

                <!-- ===================================================== -->
                <!-- Project Request Intake Tab -->
                <!-- ===================================================== -->
                <page string="Project Request Intake" invisible="request_type != 'project_request'">

                    <group string="Client Information" col="2">
                        <group>
                            <field name="intake_client_name" readonly="1"/>
                            <field name="intake_client_email" readonly="1"/>
                            <field name="intake_client_phone" readonly="1"/>
                            <field name="intake_company_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="intake_state" readonly="1"/>
                        </group>
                    </group>

                    <group string="Review Information"
                           invisible="intake_state == 'submitted'">
                        <group>
                            <field name="intake_reviewed_by" readonly="1"/>
                            <field name="intake_review_date" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Requested Project Details"/>

                    <group col="2">
                        <group>
                            <field name="intake_project_title" readonly="1"/>
                            <field name="intake_requested_budget" readonly="1"/>
                            <field name="intake_requested_duration" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_type" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="intake_project_description" readonly="1" nolabel="0"/>
                        <field name="intake_requested_notes" readonly="1" nolabel="0"/>
                    </group>

                    <separator string="Rejection Details"
                               invisible="type != 'lead' or intake_state != 'rejected'"/>

                    <group invisible="type != 'lead' or intake_state != 'rejected'">
                        <field name="intake_rejection_reason"
                               groups="crm_workflow_custom.group_crm_workflow_manager"
                               readonly="1"/>
                    </group>

                </page>

                <!-- ===================================================== -->
                <!-- Project Review Details Tab -->
                <!-- ===================================================== -->
                <page string="Project Review Details"
                    groups="crm_workflow_custom.group_crm_workflow_manager"
                    invisible="request_type != 'project_request' or intake_state in ['draft', 'submitted', 'rejected']">

                    <group string="Project Classification" col="2">
                        <group>
                            <field name="review_project_type_id" placeholder="Select the main project type"/>
                            <field name="review_client_segment_id" options="{'no_create_edit': False}"/>
                        </group>
                    </group>

                    <separator string="Technical Scope"/>

                    <group string="Development and Features">
                        <field name="review_project_feature_ids" widget="many2many_tags"/>
                    </group>

                    <separator string="Internal Project Analysis"/>

                    <group>
                        <field name="review_project_features"
                            placeholder="Write the important project modules, pages, functions, integrations, or requested features"/>
                        <field name="intake_meeting_notes"
                            placeholder="Write key points discussed with the client during the meeting"/>
                        <field name="intake_project_requirements"
                            placeholder="Write the confirmed business and technical requirements"/>
                        <field name="intake_solution_summary"
                            placeholder="Summarize the proposed solution approach"/>
                        <field name="review_recommendation"
                            placeholder="Write the manager recommendation before approval"/>
                        <field name="review_risk_notes"
                            placeholder="Write any risks, dependencies, or technical concerns"/>
                    </group>

                </page>


                <page string="Email Logs">
                    <field name="email_log_ids" readonly="1">
                        <list>
                            <field name="email_date"/>
                            <field name="direction"/>
                            <field name="email_type"/>
                            <field name="subject"/>
                            <field name="sender_email"/>
                            <field name="recipient_email"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
        
        </record>

        <record id="view_crm_project_request_intake_kanban" model="ir.ui.view">
        <field name="name">crm.project.request.intake.kanban</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <kanban class="o_cpri_kanban_view"
                    default_group_by="intake_state"
                    create="false"
                    quick_create="false"
                    sample="1">
                <field name="name"/>
                <field name="type"/>
                <field name="request_type"/>
                <field name="intake_state"/>
                <field name="intake_client_name"/>
                <field name="intake_client_email"/>
                <field name="intake_client_phone"/>
                <field name="intake_company_name"/>
                <field name="intake_project_title"/>
                <field name="intake_requested_budget"/>
                <field name="intake_requested_duration"/>
                <field name="review_project_type_id"/>
                <field name="review_client_segment_id"/>
                <field name="assignment_count"/>
                <field name="email_log_count"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_cpri_card oe_kanban_global_click">

                            <div class="o_cpri_card_header">
                                <div>
                                    <div class="o_cpri_title">
                                        <field name="intake_project_title"/>
                                    </div>
                                    <div class="o_cpri_subtitle">
                                        <field name="intake_company_name"/>
                                    </div>
                                </div>

                                <span t-attf-class="o_cpri_status o_cpri_status_#{record.intake_state.raw_value}">
                                    <field name="intake_state"/>
                                </span>
                            </div>

                            <div class="o_cpri_client_block">
                                <div class="o_cpri_client_name">
                                    <i class="fa fa-user"/>
                                    <field name="intake_client_name"/>
                                </div>

                                <div class="o_cpri_client_info">
                                    <span>
                                        <i class="fa fa-envelope"/>
                                        <field name="intake_client_email"/>
                                    </span>
                                    <span>
                                        <i class="fa fa-phone"/>
                                        <field name="intake_client_phone"/>
                                    </span>
                                </div>
                            </div>

                            <div class="o_cpri_details_grid">
                                <div class="o_cpri_detail_item">
                                    <span class="o_cpri_detail_label">Budget</span>
                                    <span class="o_cpri_detail_value">
                                        <field name="intake_requested_budget"/>
                                    </span>
                                </div>

                                <div class="o_cpri_detail_item">
                                    <span class="o_cpri_detail_label">Duration</span>
                                    <span class="o_cpri_detail_value">
                                        <field name="intake_requested_duration"/>
                                    </span>
                                </div>
                            </div>

                            <div class="o_cpri_review_block">
                                <t t-if="record.review_project_type_id.raw_value">
                                    <span class="o_cpri_tag">
                                        <i class="fa fa-cube"/>
                                        <field name="review_project_type_id"/>
                                    </span>
                                </t>

                                <t t-if="record.review_client_segment_id.raw_value">
                                    <span class="o_cpri_tag">
                                        <i class="fa fa-building"/>
                                        <field name="review_client_segment_id"/>
                                    </span>
                                </t>
                            </div>

                            <div class="o_cpri_card_footer">
                                <span>
                                    <i class="fa fa-users"/>
                                    <field name="assignment_count"/> Assignments
                                </span>

                                <span>
                                    <i class="fa fa-envelope-o"/>
                                    <field name="email_log_count"/> Emails
                                </span>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_crm_lead_form_hide_workflow_tabs_for_project_request" model="ir.ui.view">
        <field name="name">crm.lead.form.hide.workflow.tabs.for.project.request</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm_workflow_custom.view_crm_lead_form_workflow_custom"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@type='action' and @name='662']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//header//button[@type='action' and @name='661']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='crmwf_approval_followup']" position="attributes">
                <attribute name="invisible">type == 'lead'</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_crm_lead_form_remove_default_lost_button" model="ir.ui.view">
        <field name="name">crm.lead.form.remove.default.lost.button</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="replace"/>

        </field>
    </record>

</odoo>
