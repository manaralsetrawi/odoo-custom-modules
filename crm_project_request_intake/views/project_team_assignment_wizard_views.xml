<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_team_assignment_wizard_form" model="ir.ui.view">
        <field name="name">project.team.assignment.wizard.form</field>
        <field name="model">project.team.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Project Team">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id" readonly="1"/>
                            <field name="project_type_id" readonly="1"/>
                            <field name="planned_start_date"/>
                            <field name="planned_end_date"/>
                        </group>

                        <group>
                            <field name="suggested_team_id" readonly="1"/>
                            <field name="selected_team_id"/>
                            <field name="assignment_notes"/>
                        </group>
                    </group>

                    <group string="Assigned Resources">
                        <field name="assignment_line_ids">
                            <list editable="bottom">
                                <field name="employee_id"/>
                                <field name="employee_team_id" readonly="1"/>
                                <field name="workload_percentage"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </group>
                </sheet>

                <footer>
                    <button name="action_confirm_assignment"
                            string="Confirm Assignment"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
