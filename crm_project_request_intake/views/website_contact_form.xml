<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         Project Request Page
         ========================================================= -->
    <template id="project_request_page" name="Project Request Page">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_text_block pt80 pb80">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                <h1 class="mb-3">Project Request</h1>
                                <p class="mb-4">
                                    Please fill in the form below to submit your project request.
                                </p>

                                <form action="/project_request/submit"
                                      method="post"
                                      id="crm_project_request_form"
                                      novalidate="novalidate">

                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div id="form_validation_alert"
                                         class="alert alert-danger d-none"
                                         role="alert">
                                        Please fix the highlighted fields before submitting the form.
                                    </div>

                                    <div id="form_success_alert"
                                         class="alert alert-success d-none"
                                         role="alert">
                                        Your request has been submitted successfully.
                                    </div>

                                    <div class="row g-3">

                                        <div class="col-12">
                                            <label for="pr_name" class="form-label">Full Name</label>
                                            <input type="text"
                                                   name="name"
                                                   id="pr_name"
                                                   class="form-control"
                                                   data-label="Full Name"
                                                   required="required"/>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="pr_email" class="form-label">Email</label>
                                            <input type="email"
                                                   name="email"
                                                   id="pr_email"
                                                   class="form-control"
                                                   data-label="Email"
                                                   required="required"/>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="pr_phone" class="form-label">Phone Number</label>
                                            <input type="text"
                                                   name="phone"
                                                   id="pr_phone"
                                                   class="form-control"
                                                   data-label="Phone Number"
                                                   required="required"/>
                                        </div>

                                        <div class="col-12">
                                            <label for="pr_request_type" class="form-label">Message Type</label>
                                            <select name="request_type"
                                                    id="pr_request_type"
                                                    class="form-select"
                                                    data-label="Message Type"
                                                    required="required">
                                                <option value="general_inquiry">General Inquiry</option>
                                                <option value="project_request" selected="selected">Project Request</option>
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label for="pr_message" class="form-label">Message</label>
                                            <textarea name="message"
                                                      id="pr_message"
                                                      class="form-control"
                                                      rows="4"
                                                      data-label="Message"
                                                      required="required"></textarea>
                                        </div>

                                    </div>

                                    <div id="project_request_fields" class="mt-4">
                                        <div class="row g-3">

                                            <div class="col-12">
                                                <label for="pr_company_name" class="form-label">Company Name</label>
                                                <input type="text"
                                                       name="intake_company_name"
                                                       id="pr_company_name"
                                                       class="form-control"
                                                       data-label="Company Name"
                                                       required="required"/>
                                            </div>

                                            <div class="col-12">
                                                <label for="pr_project_title" class="form-label">Project Title</label>
                                                <input type="text"
                                                       name="intake_project_title"
                                                       id="pr_project_title"
                                                       class="form-control"
                                                       data-label="Project Title"
                                                       required="required"/>
                                            </div>

                                            <div class="col-12">
                                                <label for="pr_project_description" class="form-label">Project Description</label>
                                                <textarea name="intake_project_description"
                                                          id="pr_project_description"
                                                          class="form-control"
                                                          rows="4"
                                                          data-label="Project Description"
                                                          required="required"></textarea>
                                            </div>

                                            <div class="col-md-6">
                                                <label for="pr_requested_budget" class="form-label">Expected Budget</label>
                                                <input type="number"
                                                       step="0.01"
                                                       min="0"
                                                       name="intake_requested_budget"
                                                       id="pr_requested_budget"
                                                       class="form-control"
                                                       data-label="Expected Budget"
                                                       required="required"/>
                                            </div>

                                            <div class="col-md-6">
                                                <label for="pr_requested_duration" class="form-label">Expected Duration</label>
                                                <input type="text"
                                                       name="intake_requested_duration"
                                                       id="pr_requested_duration"
                                                       class="form-control"
                                                       placeholder="Example: 3 months"
                                                       data-label="Expected Duration"
                                                       required="required"/>
                                            </div>

                                            <div class="col-12">
                                                <label for="pr_requested_notes" class="form-label">Additional Notes</label>
                                                <textarea name="intake_requested_notes"
                                                          id="pr_requested_notes"
                                                          class="form-control"
                                                          rows="3"
                                                          data-label="Additional Notes"
                                                          required="required"></textarea>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="mt-4 d-flex justify-content-end">
                                        <button type="submit"
                                                class="btn btn-primary px-4 py-2"
                                                id="pr_submit_btn">
                                            Submit
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

