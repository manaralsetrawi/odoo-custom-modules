<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_purchase_execution_workflow" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.purchase.execution.workflow</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Add the related Purchase Request field near the vendor field.
                 This helps procurement users know which request this RFQ/PO belongs to. -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="purchase_request_id"/>
            </xpath>

            <!-- Add a simple technical section for Phase 1 helper fields.
                 These fields help in testing and later business validations. -->
            <xpath expr="//sheet" position="inside">
                <group string="Procurement Execution - Phase 1">
                    <group>
                        <field name="has_purchase_request" readonly="1"/>
                        <field name="quotation_count_for_request" readonly="1"/>
                    </group>
                    <group>
                        <field name="is_above_quotation_threshold" readonly="1"/>
                        <field name="is_multi_quotation_case" readonly="1"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>