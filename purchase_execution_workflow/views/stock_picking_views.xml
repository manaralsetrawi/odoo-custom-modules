<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_picking_form_inherit_purchase_execution_workflow" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.purchase.execution.workflow</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_confirm_end_user_receipt"
                        type="object"
                        string="Confirm Receipt Compliance"
                        class="btn-primary"
                        invisible="state != 'done' or end_user_confirmed"
                        confirm="Are you sure you want to confirm receipt compliance for this delivery?"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Goods Receipt Confirmation">
                    <group>
                        <group>
                            <field name="is_grn_required"/>
                            <field name="end_user_confirmed" readonly="1"/>
                            <field name="end_user_confirmed_by" readonly="1"/>
                            <field name="end_user_confirmed_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="compliance_status"/>
                            <field name="compliance_notes"
                                   placeholder="Describe any issues such as damage, missing items, or confirm that the delivery is fully compliant..."/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>