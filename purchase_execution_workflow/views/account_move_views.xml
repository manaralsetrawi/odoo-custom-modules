<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_vendor_bill_form_inherit_purchase_execution_workflow" model="ir.ui.view">
        <field name="name">account.move.form.inherit.purchase.execution.workflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Invoice verification section -->
            <xpath expr="//sheet" position="inside">
                <group string="Invoice Verification"
                       invisible="move_type != 'in_invoice'">
                    <group>
                        <field name="purchase_order_id"/>
                        <field name="purchase_request_id" readonly="1"/>
                        <field name="invoice_verification_status" readonly="1"/>
                    </group>
                    <group>
                        <field name="invoice_verified_by" readonly="1"/>
                        <field name="invoice_verified_date" readonly="1"/>
                        <field name="payment_tracking_status" readonly="1"/>
                    </group>
                    <group>
                        <field name="is_vendor_bill" readonly="1"/>
                    </group>
                    <field name="invoice_rejection_reason"
                           placeholder="Enter the reason if this vendor bill is rejected..."/>
                </group>
            </xpath>

            <!-- Header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_verify_vendor_bill"
                        type="object"
                        string="Verify Invoice"
                        class="btn-primary"
                        groups="purchase_execution_workflow.group_invoice_verifier"
                        invisible="move_type != 'in_invoice' or invoice_verification_status == 'verified'"/>

                <button name="action_reject_vendor_bill"
                        type="object"
                        string="Reject Invoice"
                        class="btn-danger"
                        groups="purchase_execution_workflow.group_invoice_verifier"
                        invisible="move_type != 'in_invoice' or invoice_verification_status == 'rejected'"/>
            </xpath>

        </field>
    </record>
</odoo>