<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_invoice_reject_wizard_form" model="ir.ui.view">
        <field name="name">invoice.reject.wizard.form</field>
        <field name="model">invoice.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Invoice">
                <group>
                    <field name="account_move_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="Enter the reason for invoice rejection..."/>
                </group>
                <footer>
                    <button name="action_confirm_rejection"
                            type="object"
                            string="Confirm Rejection"
                            class="btn-danger"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>