<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban view -->
    <record id="view_expense_request_kanban" model="ir.ui.view">
        <field name="name">expense.request.kanban</field>
        <field name="model">expense.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile ncst_expense_request_kanban">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="expense_type_id"/>
                <field name="amount"/>
                <field name="expense_date"/>
                <field name="state"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click ncst_expense_request_card">

                            <div class="ncst_expense_request_header">
                                <div class="ncst_expense_request_header_main">
                                    <div class="ncst_expense_request_label">
                                        Expense Request
                                    </div>
                                    <div class="ncst_expense_request_name">
                                        <field name="name"/>
                                    </div>
                                </div>

                                <div class="ncst_expense_request_badge_wrap">
                                    <field name="state" widget="badge"
                                        decoration-muted="state == 'draft'"
                                        decoration-warning="state == 'submitted'"
                                        decoration-info="state == 'approved_manager'"
                                        decoration-primary="state == 'approved_finance'"
                                        decoration-success="state == 'paid'"
                                        decoration-danger="state == 'rejected'"/>
                                </div>
                            </div>

                            <div class="ncst_expense_request_stats">
                                <div class="ncst_expense_request_stat ncst_expense_request_stat_soft">
                                    <div class="ncst_expense_request_stat_label">Employee</div>
                                    <div class="ncst_expense_request_stat_value">
                                        <field name="employee_id"/>
                                    </div>
                                </div>

                                <div class="ncst_expense_request_stat ncst_expense_request_stat_soft">
                                    <div class="ncst_expense_request_stat_label">Expense Type</div>
                                    <div class="ncst_expense_request_stat_value">
                                        <field name="expense_type_id"/>
                                    </div>
                                </div>

                                <div class="ncst_expense_request_stat ncst_expense_request_stat_primary">
                                    <div class="ncst_expense_request_stat_label">Amount</div>
                                    <div class="ncst_expense_request_stat_value">
                                        <field name="amount"/>
                                    </div>
                                </div>
                            </div>

                            <div class="ncst_expense_request_meta">
                                <div class="ncst_expense_request_meta_box">
                                    <div class="ncst_expense_request_meta_label">Department</div>
                                    <div class="ncst_expense_request_meta_value">
                                        <field name="department_id"/>
                                    </div>
                                </div>

                                <div class="ncst_expense_request_meta_box">
                                    <div class="ncst_expense_request_meta_label">Expense Date</div>
                                    <div class="ncst_expense_request_meta_value">
                                        <field name="expense_date"/>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List view -->
    <record id="view_expense_request_list" model="ir.ui.view">
        <field name="name">expense.request.list</field>
        <field name="model">expense.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="expense_type_id"/>
                <field name="amount"/>
                <field name="expense_date"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-info="state == 'approved_manager'"
                       decoration-primary="state == 'approved_finance'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_expense_request_form" model="ir.ui.view">
        <field name="name">expense.request.form</field>
        <field name="model">expense.request</field>
        <field name="arch" type="xml">
            <form string="Expense Request">
            
                <header>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_manager_approve"
                            string="Approve Requsest"
                            type="object"
                            class="btn-success"
                            invisible="not can_manager_approve"/>

                    <button name="action_open_manager_reject_wizard"
                            string="Manager Reject"
                            type="object"
                            class="btn-danger"
                            invisible="not can_manager_approve"/>

                    <button name="action_finance_approve"
                            string="Finance Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'approved_manager'"
                            groups="ncst_expense_management.group_expense_finance"/>

                    <button name="action_mark_paid"
                            string="Mark as Paid"
                            type="object"
                            class="btn-secondary"
                            invisible="not can_mark_paid"
                            groups="ncst_budget_management.group_budget_finance_manager"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved_manager,approved_finance,paid,rejected"/>
                </header>

                <sheet>
                    <group string="Expense Information">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="manager_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="expense_type_id" readonly="state != 'draft'"/>
                            <field name="expense_date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Description">
                        <field name="description" readonly="state != 'draft'"/>
                    </group>

                    <group string="Attachment">
                        <field name="attachment" filename="attachment_name" readonly="state != 'draft'"/>
                        <field name="attachment_name" invisible="1"/>
                    </group>

                    <group string="Budget Integration">
                        <field name="budget_reservation_id" readonly="1"/>
                    </group>

                    <group string="Tracking Information">
                        <group>
                            <field name="submitted_by" readonly="1" invisible="state not in ['submitted', 'approved_manager', 'approved_finance', 'paid', 'rejected']"/>
                            <field name="submitted_date" readonly="1" invisible="state not in ['submitted', 'approved_manager', 'approved_finance', 'paid', 'rejected']"/>
                            <field name="manager_approved_by" readonly="1" invisible="state not in ['approved_manager', 'approved_finance', 'paid']"/>
                            <field name="manager_approval_date" readonly="1" invisible="state not in ['approved_manager', 'approved_finance', 'paid']"/>
                        </group>

                        <group>
                            <field name="finance_approved_by" readonly="1" invisible="state not in ['approved_finance', 'paid']"/>
                            <field name="finance_approval_date" readonly="1" invisible="state not in ['approved_finance', 'paid']"/>
                            <field name="paid_by" readonly="1" invisible="state != 'paid'"/>
                            <field name="paid_date" readonly="1" invisible="state != 'paid'"/>
                        </group>
                    </group>

                    <group string="Rejection Information" invisible="state != 'rejected'">
                        <group>
                            <field name="rejected_by" readonly="1"/>
                            <field name="rejected_date" readonly="1"/>
                            <field name="rejection_reason" readonly="1"/>
                        </group>
                    </group>
                </sheet>

                <field name="can_manager_approve" invisible="1"/>
                <field name="budget_reservation_state" invisible="1"/>
                <field name="can_mark_paid" invisible="1"/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_my_expense_request" model="ir.actions.act_window">
        <field name="name">My Expense Requests</field>
        <field name="res_model">expense.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first expense request
            </p>
            <p>
                View and manage your own expense requests.
            </p>
        </field>
    </record>

    <record id="action_expense_request_all" model="ir.actions.act_window">
        <field name="name">All Expense Requests</field>
        <field name="res_model">expense.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No expense requests found
            </p>
            <p>
                View and manage all expense requests from all employees.
            </p>
        </field>
    </record>

    <record id="action_expense_type" model="ir.actions.act_window">
        <field name="name">Expense Types</field>
        <field name="res_model">expense.type</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first expense type
            </p>
            <p>
                Manage the expense categories used in employee expense requests.
            </p>
        </field>
    </record>

    <record id="action_team_expense_request" model="ir.actions.act_window">
        <field name="name">Team Expense Requests</field>
        <field name="res_model">expense.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('manager_user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No team expense requests found
            </p>
            <p>
                Review and approve expense requests submitted by your employees.
            </p>
        </field>
    </record>
</odoo>