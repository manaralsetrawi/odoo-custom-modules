<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_expense_reject_wizard_form" model="ir.ui.view">
        <field name="name">expense.reject.wizard.form</field>
        <field name="model">expense.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Expense Request">
                <group>
                    <field name="expense_request_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="Enter the reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>