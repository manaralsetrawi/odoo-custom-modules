<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_purchase_request_tree" model="ir.ui.view">
            <field name="name">purchase.request.tree</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="department_id"/>
                    <field name="requester_category"/>
                    <field name="required_date"/>
                    <field name="amount_total"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_purchase_request_form" model="ir.ui.view">
            <field name="name">purchase.request.form</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <form string="Purchase Request">
                    <header>
                        <button name="action_submit"
                                type="object"
                                string="Submit"
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <button name="action_coordinator_approve"
                                type="object"
                                string="Coordinator Approve"
                                class="btn-success"
                                groups="purchase.group_pr_coordinator"
                                invisible="state != 'waiting_coordinator'"/>

                        <button name="action_principal_approve"
                                type="object"
                                string="Principal / Vice Principal Approve"
                                class="btn-success"
                                groups="purchase.group_principal,purchase.group_vice_principal"
                                invisible="state != 'waiting_principal'"/>

                        <button name="action_director_approve"
                                type="object"
                                string="Director Approve"
                                class="btn-success"
                                groups="purchase.group_department_director"
                                invisible="state != 'waiting_director'"/>

                        <button name="action_reject"
                                type="object"
                                string="Reject"
                                class="btn-danger"
                                invisible="state not in ('waiting_coordinator','waiting_principal','waiting_director','waiting_budget')"/>

                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,waiting_coordinator,waiting_principal,waiting_director,waiting_budget,approved,rejected"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="requester_id"/>
                                <field name="department_id" readonly="1"/>
                                <field name="requester_category"/>
                            </group>
                            <group>
                                <field name="required_date"/>
                                <field name="state" readonly="1"/>
                                <field name="amount_total" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <field name="reason"/>
                        </group>
                        
                        <group string="Approval Information">
                            <group>
                                <field name="coordinator_approved_by" readonly="1"/>
                                <field name="coordinator_approved_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="principal_approved_by" readonly="1"/>
                                <field name="principal_approved_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="director_approved_by" readonly="1"/>
                                <field name="director_approved_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="rejection_reason"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Request Lines">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="product_description"/>
                                        <field name="specifications"/>
                                        <field name="quantity"/>
                                        <field name="estimated_unit_price"/>
                                        <field name="subtotal" readonly="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>

                        <div class="oe_chatter">
                            <field name="message_follower_ids"/>
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_purchase_request" model="ir.actions.act_window">
            <field name="name">Purchase Requests</field>
            <field name="res_model">purchase.request</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>