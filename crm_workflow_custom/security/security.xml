<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         CRM Workflow Groups
         ========================================================= -->
    <record id="group_crm_workflow_user" model="res.groups">
        <field name="name">CRM Workflow User</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
        <field name="implied_ids" eval="[(4, ref('crm.group_use_lead'))]"/>
    </record>

    <record id="group_crm_workflow_manager" model="res.groups">
        <field name="name">CRM Workflow Manager</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_crm_workflow_user'))]"/>
    </record>

    <record id="group_crm_technical_reviewer" model="res.groups">
        <field name="name">CRM Technical Reviewer</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_crm_workflow_user'))]"/>
    </record>

    <!-- =========================================================
         Support Groups
         ========================================================= -->
    <record id="group_crm_support_user" model="res.groups">
        <field name="name">CRM Support User</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_crm_support_manager" model="res.groups">
        <field name="name">CRM Support Manager</field>
        <field name="category_id" ref="base.module_category_sales_crm"/>
        <field name="implied_ids" eval="[(4, ref('group_crm_support_user'))]"/>
    </record>


</odoo>