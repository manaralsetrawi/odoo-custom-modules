<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_support_ticket_list" model="ir.ui.view">
        <field name="name">crm.support.ticket.list</field>
        <field name="model">crm.support.ticket</field>
        <field name="arch" type="xml">
            <list string="Support Tickets">
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="assigned_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_crm_support_ticket_form" model="ir.ui.view">
        <field name="name">crm.support.ticket.form</field>
        <field name="model">crm.support.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket" class="crmwf_support_form">
                <header>
                    <button name="action_mark_in_progress"
                            type="object"
                            string="Start Progress"
                            class="btn-primary crmwf_btn crmwf_btn_primary"
                            invisible="status != 'new'"
                            groups="crm_workflow_custom.group_crm_support_user,crm_workflow_custom.group_crm_support_manager"/>

                    <button name="action_mark_resolved"
                            type="object"
                            string="Resolve"
                            class="btn-success crmwf_btn crmwf_btn_success"
                            invisible="status not in ('in_progress', 'waiting_customer')"
                            groups="crm_workflow_custom.group_crm_support_user,crm_workflow_custom.group_crm_support_manager"/>

                    <button name="action_mark_closed"
                            type="object"
                            string="Close"
                            class="btn-secondary crmwf_btn crmwf_btn_secondary"
                            invisible="status != 'resolved'"
                            groups="crm_workflow_custom.group_crm_support_manager"/>

                    <field name="status" widget="statusbar" statusbar_visible="new,in_progress,waiting_customer,resolved,closed"/>
                </header>

                <sheet class="crmwf_support_sheet">
                    <group class="crmwf_row">
                        <group class="crmwf_card crmwf_card_support_main">
                            <field name="name" readonly="1"/>
                            <field name="subject"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                        </group>
                        <group class="crmwf_card crmwf_card_support_side">
                            <field name="priority"/>
                            <field name="assigned_user_id"/>
                        </group>
                    </group>

                    <notebook class="crmwf_support_notebook">
                        <page string="Description" class="crmwf_support_desc_page">
                            <field name="description" placeholder="Describe the issue..."/>
                        </page>
                        <page string="Resolution" class="crmwf_support_resolution_page">
                            <field name="resolution_notes" placeholder="Add resolution notes here..."/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>
</odoo>