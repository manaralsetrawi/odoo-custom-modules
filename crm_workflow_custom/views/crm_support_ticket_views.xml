<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_crm_support_ticket_list" model="ir.ui.view">
        <field name="name">crm.support.ticket.list</field>
        <field name="model">crm.support.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="lead_id"/>
                <field name="priority"/>
                <field name="status"/>
                <field name="assigned_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_crm_support_ticket_form" model="ir.ui.view">
        <field name="name">crm.support.ticket.form</field>
        <field name="model">crm.support.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_in_progress" type="object" string="Start Progress" class="btn-primary"/>
                    <button name="action_mark_resolved" type="object" string="Resolve" class="btn-success"/>
                    <button name="action_mark_closed" type="object" string="Close" class="btn-secondary"/>
                    <field name="status" widget="statusbar" statusbar_visible="new,in_progress,waiting_customer,resolved,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="subject"/>
                            <field name="partner_id"/>
                            <field name="lead_id"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="assigned_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Resolution">
                            <field name="resolution_notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>