<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_reject_wizard_form" model="ir.ui.view">
        <field name="name">crm.reject.wizard.form</field>
        <field name="model">crm.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Project">
                <sheet>
                    <group>
                        <field name="lead_id" readonly="1"/>
                        <field name="rejection_reason" placeholder="Enter the rejection reason here..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_reject"
                            string="Confirm Rejection"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>