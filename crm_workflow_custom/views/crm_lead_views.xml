<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_lead_form_workflow_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.workflow.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Title -->
            <xpath expr="//div[contains(@class, 'oe_title')]" position="replace">
                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="Enter project request title..." required="1"/>
                    </h1>
                </div>
            </xpath>

            <!-- Helper fields -->
            <xpath expr="//form/sheet" position="inside">
                <field name="is_stage_new_inquiry" invisible="1"/>
                <field name="is_stage_initial_discussion" invisible="1"/>
                <field name="is_stage_analysis" invisible="1"/>
                <field name="is_stage_solution_design" invisible="1"/>
                <field name="is_stage_proposal" invisible="1"/>
                <field name="is_stage_waiting_approval" invisible="1"/>
                <field name="is_stage_approved" invisible="1"/>
                <field name="is_stage_rejected" invisible="1"/>

                <field name="show_start_analysis_btn" invisible="1"/>
                <field name="show_submit_proposal_btn" invisible="1"/>
                <field name="show_send_to_approval_btn" invisible="1"/>
                <field name="show_approve_btn" invisible="1"/>
                <field name="show_reject_btn" invisible="1"/>
            </xpath>

            <!-- Contact required only for your internal flow records -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="required">type != 'lead'</attribute>
            </xpath>

            <!-- Hide default Lost button -->
            <xpath expr="//header//button[@type='action' and @name='661']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Expected Closing -->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Tags -->
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Main workflow buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_start_analysis"
                        type="object"
                        string="Start Analysis"
                        class="btn-primary crmwf_btn crmwf_btn_primary"
                        groups="crm_workflow_custom.group_crm_workflow_user,crm_workflow_custom.group_crm_workflow_manager,crm_workflow_custom.group_crm_technical_reviewer"
                        invisible="not show_start_analysis_btn"/>

                <button name="action_submit_proposal"
                        type="object"
                        string="Submit Proposal"
                        class="btn-primary crmwf_btn crmwf_btn_primary"
                        groups="crm_workflow_custom.group_crm_workflow_user,crm_workflow_custom.group_crm_workflow_manager"
                        invisible="not show_submit_proposal_btn"/>

                <button name="action_send_to_approval"
                        type="object"
                        string="Send to Approval"
                        class="btn-primary crmwf_btn crmwf_btn_primary"
                        groups="crm_workflow_custom.group_crm_workflow_user,crm_workflow_custom.group_crm_workflow_manager"
                        invisible="not show_send_to_approval_btn"/>

                <button name="action_approve_project"
                        type="object"
                        string="Approve"
                        class="btn-success crmwf_btn crmwf_btn_success"
                        groups="crm_workflow_custom.group_crm_workflow_manager"
                        invisible="not show_approve_btn"/>

                <button name="action_reject_project"
                        type="object"
                        string="Reject"
                        class="btn-danger crmwf_btn crmwf_btn_danger"
                        groups="crm_workflow_custom.group_crm_workflow_manager"
                        invisible="not show_reject_btn"/>
            </xpath>

            <!-- Important workflow summary outside tabs -->
            <xpath expr="//sheet/notebook" position="before">
                <div class="crmwf_summary_wrap" invisible="type == 'lead'">
                    <group class="crmwf_row">
                        <group string="Workflow Summary" class="crmwf_card crmwf_card_summary">
                            <field name="technical_feasibility"/>
                            <field name="complexity_level"/>
                            <field name="approval_state" readonly="1"/>
                        </group>

                        <group string="Planning Summary" class="crmwf_card crmwf_card_summary">
                            <field name="estimated_duration"/>
                            <field name="project_deadline"/>
                            <field name="proposal_amount"/>
                        </group>
                    </group>
                </div>
            </xpath>

            <!-- Workflow tabs -->
            <xpath expr="//sheet/notebook" position="inside">
                <page name="crmwf_workflow_overview"
                      string="Workflow Overview"
                      class="crmwf_workflow_page"
                      groups="crm_workflow_custom.group_crm_workflow_user,crm_workflow_custom.group_crm_workflow_manager,crm_workflow_custom.group_crm_technical_reviewer">

                    <div class="crmwf_hint_box">
                        <div class="crmwf_hint_title">Workflow Guidance</div>
                        <div class="crmwf_hint_text">
                            Review the request, complete the technical evaluation, prepare the proposal, then send it for approval.
                        </div>
                    </div>

                    <group class="crmwf_row">
                        <group string="Proposal Details" class="crmwf_card crmwf_card_proposal">
                            <field name="proposal_summary"
                                   placeholder="Enter a short summary of the proposed solution..."
                                   required="is_stage_analysis or is_stage_solution_design or is_stage_proposal"/>
                            <field name="negotiation_notes"
                                   placeholder="Add any negotiation comments or client feedback..."/>
                        </group>
                    </group>
                </page>

                <page name="crmwf_approval_followup"
                      string="Approval &amp; Follow-up"
                      class="crmwf_workflow_page"
                      groups="crm_workflow_custom.group_crm_workflow_user,crm_workflow_custom.group_crm_workflow_manager,crm_workflow_custom.group_crm_technical_reviewer">

                    <group class="crmwf_row">
                        <group string="Approval Information" class="crmwf_card crmwf_card_approval">
                            <field name="approval_state" readonly="1"/>
                            <field name="rejection_reason"
                                   invisible="approval_state != 'rejected'"
                                   placeholder="Enter the reason for rejection..."/>
                        </group>

                        <group string="Follow-up Tracking" class="crmwf_card crmwf_card_followup">
                            <field name="last_followup_date"/>
                            <field name="next_followup_date"/>
                            <field name="followup_status"/>
                            <field name="inactive_alert" readonly="1" widget="boolean_toggle"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Extra visibility fix so buttons always follow computed helper fields -->
    <record id="view_crm_lead_form_workflow_button_visibility_fix" model="ir.ui.view">
        <field name="name">crm.lead.form.workflow.button.visibility.fix</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm_workflow_custom.view_crm_lead_form_workflow_custom"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_start_analysis']" position="attributes">
                <attribute name="invisible">not show_start_analysis_btn</attribute>
            </xpath>

            <xpath expr="//button[@name='action_submit_proposal']" position="attributes">
                <attribute name="invisible">not show_submit_proposal_btn</attribute>
            </xpath>

            <xpath expr="//button[@name='action_send_to_approval']" position="attributes">
                <attribute name="invisible">not show_send_to_approval_btn</attribute>
            </xpath>

            <xpath expr="//button[@name='action_approve_project']" position="attributes">
                <attribute name="invisible">not show_approve_btn</attribute>
            </xpath>

            <xpath expr="//button[@name='action_reject_project']" position="attributes">
                <attribute name="invisible">not show_reject_btn</attribute>
            </xpath>

        </field>
    </record>

</odoo>