<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Dashboard parent menu only, no action -->
    <menuitem id="menu_crm_custom_dashboard_root"
              name="Dashboard"
              parent="crm.crm_menu_root"
              sequence="5"
              groups="crm_workflow_custom.group_crm_workflow_user,crm_workflow_custom.group_crm_workflow_manager"/>

    <!-- Opportunity Dashboard action -->
    <record id="action_crm_opportunity_dashboard" model="ir.actions.client">
        <field name="name">Opportunity Dashboard</field>
        <field name="tag">crm_dashboard_tag</field>
    </record>

    <!-- Child menu under Dashboard -->
    <menuitem id="menu_crm_opportunity_dashboard"
              name="Opportunity Dashboard"
              parent="menu_crm_custom_dashboard_root"
              action="action_crm_opportunity_dashboard"
              sequence="10"
              groups="crm_workflow_custom.group_crm_workflow_user,crm_workflow_custom.group_crm_workflow_manager"/>

    <!-- Force CRM My Activities to open Kanban first and show only project request opportunities -->
    <record id="crm.crm_lead_action_my_activities" model="ir.actions.act_window">
        <field name="view_id" eval="False"/>
        <field name="view_mode">kanban,list,graph,pivot,calendar,form,activity</field>
        <field name="domain">[
            ('type', '=', 'opportunity'),
            ('request_type', '=', 'project_request'),
            ('active', 'in', [True, False]),
            ('activity_ids.active', 'in', [True, False])
        ]</field>
        <field name="context">{
            'default_type': 'opportunity',
            'default_request_type': 'project_request',
            'search_default_my_pipeline': 0,
            'search_default_assigned_to_me': 0,
            'create': False,
            'force_search_count': 1
        }</field>
    </record>
    <!-- add Create Project Request action -->
    <record id="action_create_project_request" model="ir.actions.act_window">
    <field name="name">Create Project Request</field>
    <field name="res_model">crm.lead</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
    <field name="context">{
        'default_type': 'opportunity',
        'default_request_type': 'project_request',
        'search_default_my_pipeline': 0,
        'search_default_assigned_to_me': 0,
        'search_default_user_id': 0,
        'search_default_activities_overdue': 0,
        'search_default_activities_today': 0,
        'search_default_activities_upcoming_all': 0,
        'force_search_count': 1
    }</field>
</record>

</odoo>