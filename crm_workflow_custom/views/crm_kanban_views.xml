<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_lead_kanban_workflow_custom" model="ir.ui.view">
        <field name="name">crm.lead.kanban.workflow.custom</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">

            <!-- Add custom class to the main card -->
            <xpath expr="//templates/t/div" position="attributes">
                <attribute name="class" add=" crmwf_kanban_card" separator=" "/>
            </xpath>

            <!-- Hide original partner/company text to avoid duplicate client name -->
            <xpath expr="//templates//field[@name='partner_name']" position="replace"/>
            
            <!-- Improve title appearance -->
            <xpath expr="//templates//field[@name='name']" position="replace">
                <div class="crmwf_kanban_title">
                    <field name="name"/>
                </div>
            </xpath>

            <!-- Inject workflow info inside main kanban template -->
            <xpath expr="//templates/t/div" position="inside">

                <div class="crmwf_kanban_extra">

                    <div class="crmwf_kanban_deadline_row">
                        <div class="crmwf_kanban_meta_value">
                            <i class="fa fa-calendar"/>
                            <span class="crmwf_kanban_meta_label">Deadline:</span>
                            <field name="project_deadline"/>
                        </div>
                    </div>

                    <div class="crmwf_kanban_status_row">
                        <div class="crmwf_kanban_status_badge">
                            <i class="fa fa-check-circle"/>
                            <span class="crmwf_kanban_meta_label">Approval:</span>
                            <span class="crmwf_kanban_meta_value">
                                <field name="approval_state"/>
                            </span>
                        </div>
                    </div>

                    <div class="crmwf_kanban_followup_row">
                        <div class="crmwf_kanban_followup_badge">
                            <i class="fa fa-bell"/>
                            <span class="crmwf_kanban_meta_label">Follow-up:</span>
                            <span class="crmwf_kanban_meta_value">
                                <field name="followup_status"/>
                            </span>
                        </div>
                    </div>

                    <div class="crmwf_kanban_client_row">
                        <i class="fa fa-user"/>
                        <span class="crmwf_kanban_meta_label">Client:</span>
                        <span class="crmwf_kanban_meta_value">
                            <field name="partner_id"/>
                        </span>
                    </div>

                    <div class="crmwf_kanban_owner_row">
                        <i class="fa fa-user-circle"/>
                        <span class="crmwf_kanban_meta_label">Owner:</span>
                        <span class="crmwf_kanban_meta_value">
                            <field name="user_id"/>
                        </span>
                    </div>

                </div>

            </xpath>

        </field>
    </record>

</odoo>