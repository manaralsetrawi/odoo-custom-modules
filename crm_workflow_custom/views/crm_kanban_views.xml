<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_crm_lead_kanban_workflow_custom" model="ir.ui.view">
        <field name="name">crm.lead.kanban.workflow.custom</field>
        <field name="model">crm.lead</field>

        <field name="inherit_id" ref="crm.crm_lead_view_kanban_inherit"/>

        <field name="arch" type="xml">

            <!-- Safely add content inside card -->
            <xpath expr="//div[contains(@class, 'o_kanban_record_body')]" position="inside">

                <div class="crmwf_kanban_extra">

                    <div class="crmwf_kanban_line">
                        <i class="fa fa-calendar"/> 
                        <field name="project_deadline"/>
                    </div>

                    <div class="crmwf_kanban_line">
                        <i class="fa fa-check-circle"/> 
                        <field name="approval_state"/>
                    </div>

                    <div class="crmwf_kanban_line">
                        <i class="fa fa-bell"/> 
                        <field name="followup_status"/>
                    </div>

                </div>

            </xpath>

        </field>
    </record>

</odoo>