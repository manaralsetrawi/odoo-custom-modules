<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         Support Ticket Action
         ========================================================= -->
    <record id="action_crm_support_ticket" model="ir.actions.act_window">
        <field name="name">Support Tickets</field>
        <field name="res_model">crm.support.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================================================
         CRM Workflow Reporting Menu
         ========================================================= -->
    <menuitem id="menu_crm_workflow_reporting_root"
              name="Workflow Analysis"
              parent="crm.crm_menu_report"
              action="action_crm_workflow_analysis"
              sequence="30"
              groups="crm_workflow_custom.group_crm_workflow_user,crm_workflow_custom.group_crm_workflow_manager"/>

    <!-- =========================================================
         Support Ticket Menu
         ========================================================= -->
    <menuitem id="menu_crm_support_root"
              name="Support Tickets"
              parent="crm.crm_menu_root"
              action="action_crm_support_ticket"
              sequence="50"
              groups="crm_workflow_custom.group_crm_support_user,crm_workflow_custom.group_crm_support_manager"/>

</odoo>