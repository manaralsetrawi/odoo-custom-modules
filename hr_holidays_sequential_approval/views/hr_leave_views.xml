<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================
             EXTEND LEAVE FORM VIEW
             ======================================== -->

        <record id="view_hr_leave_form_sequential" model="ir.ui.view">
            <field name="name">hr.leave.form.sequential</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">

                <!-- HIDE default Approve button -->
                <xpath expr="//button[@name='action_approve']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- HIDE default Refuse button -->
                <xpath expr="//button[@name='action_refuse']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- HIDE default Validate button -->
                <xpath expr="//button[@name='action_validate']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- HIDE "To Approve" status field -->
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- ========================================
                     BUTTONS AND STATUS SECTION
                     ======================================== -->

                <xpath expr="//field[@name='state']" position="after">

                    <!-- SUPERVISOR SECTION -->
                    <div style="background-color: #f0f7ff; padding: 20px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #0066cc;">
                        
                        <div class="row">
                            <div class="col-md-6">
                                <h5 style="margin-bottom: 15px; color: #333;">Supervisor Approval</h5>
                                
                                <button name="action_supervisor_approve"
                                        type="object"
                                        string="✓ Approve"
                                        class="btn btn-success"
                                        icon="fa-check"
                                        invisible="(supervisor_state not in ('pending', 'rejected')) or supervisor_id != uid"
                                        style="width: 100%; margin-bottom: 10px; font-weight: bold;"/>

                                <button name="action_supervisor_reject"
                                        type="object"
                                        string="✗ Reject"
                                        class="btn btn-danger"
                                        icon="fa-times"
                                        invisible="(supervisor_state not in ('pending', 'approved')) or supervisor_id != uid"
                                        style="width: 100%; font-weight: bold;"/>
                            </div>

                            <div class="col-md-6">
                                <h5 style="margin-bottom: 15px; color: #333;">Status</h5>
                                
                                <!-- Approved -->
                                <div attrs="{'invisible': [('supervisor_state', '!=', 'approved')]}">
                                    <span class="badge bg-success" style="font-size: 14px; padding: 10px 15px; display: block; width: 100%; text-align: center;">
                                        <i class="fa fa-check-circle"></i> Approved
                                    </span>
                                </div>
                                
                                <!-- Pending -->
                                <div attrs="{'invisible': [('supervisor_state', '!=', 'pending')]}">
                                    <span class="badge bg-warning text-dark" style="font-size: 14px; padding: 10px 15px; display: block; width: 100%; text-align: center;">
                                        <i class="fa fa-clock-o"></i> Pending
                                    </span>
                                </div>
                                
                                <!-- Rejected -->
                                <div attrs="{'invisible': [('supervisor_state', '!=', 'rejected')]}">
                                    <span class="badge bg-danger" style="font-size: 14px; padding: 10px 15px; display: block; width: 100%; text-align: center;">
                                        <i class="fa fa-times-circle"></i> Rejected
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- HR SECTION -->
                    <div style="background-color: #f0fff4; padding: 20px; border-radius: 8px; margin-bottom: 20px; border-left: 4px solid #00b341;">
                        
                        <div class="row">
                            <div class="col-md-6">
                                <h5 style="margin-bottom: 15px; color: #333;">HR Approval</h5>
                                
                                <button name="action_hr_approve"
                                        type="object"
                                        string="✓ Approve"
                                        class="btn btn-success"
                                        icon="fa-check"
                                        groups="hr.group_hr_user"
                                        invisible="supervisor_state != 'approved' or hr_state not in ('pending', 'rejected')"
                                        style="width: 100%; margin-bottom: 10px; font-weight: bold;"/>

                                <button name="action_hr_reject"
                                        type="object"
                                        string="✗ Reject"
                                        class="btn btn-danger"
                                        icon="fa-times"
                                        groups="hr.group_hr_user"
                                        invisible="supervisor_state != 'approved' or hr_state not in ('pending', 'approved')"
                                        style="width: 100%; font-weight: bold;"/>
                            </div>

                            <div class="col-md-6">
                                <h5 style="margin-bottom: 15px; color: #333;">Status</h5>
                                
                                <!-- Approved -->
                                <div attrs="{'invisible': [('hr_state', '!=', 'approved')]}">
                                    <span class="badge bg-success" style="font-size: 14px; padding: 10px 15px; display: block; width: 100%; text-align: center;">
                                        <i class="fa fa-check-circle"></i> Approved
                                    </span>
                                </div>
                                
                                <!-- Pending -->
                                <div attrs="{'invisible': [('hr_state', '!=', 'pending')]}">
                                    <span class="badge bg-warning text-dark" style="font-size: 14px; padding: 10px 15px; display: block; width: 100%; text-align: center;">
                                        <i class="fa fa-clock-o"></i> Pending
                                    </span>
                                </div>
                                
                                <!-- Rejected -->
                                <div attrs="{'invisible': [('hr_state', '!=', 'rejected')]}">
                                    <span class="badge bg-danger" style="font-size: 14px; padding: 10px 15px; display: block; width: 100%; text-align: center;">
                                        <i class="fa fa-times-circle"></i> Rejected
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden fields for backend logic -->
                    <field name="supervisor_state" invisible="1"/>
                    <field name="hr_state" invisible="1"/>
                    <field name="rejection_reason" invisible="1"/>

                </xpath>

            </field>
        </record>


        <!-- ========================================
             EXTEND LEAVE LIST VIEW - HIDE BUTTONS
             ======================================== -->

        <record id="view_hr_leave_tree_sequential" model="ir.ui.view">
            <field name="name">hr.leave.tree.sequential</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
            <field name="arch" type="xml">

                <!-- Hide action_approve button from list -->
                <xpath expr="//button[@name='action_approve']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Hide action_refuse button from list -->
                <xpath expr="//button[@name='action_refuse']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
        </record>


        <!-- ========================================
             EXTEND LEAVE KANBAN VIEW - HIDE BUTTONS
             ======================================== -->

        <record id="view_hr_leave_kanban_sequential" model="ir.ui.view">
            <field name="name">hr.leave.kanban.sequential</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
            <field name="arch" type="xml">

                <!-- Hide action_approve button in kanban -->
                <xpath expr="//button[@name='action_approve']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- Hide action_refuse button in kanban -->
                <xpath expr="//button[@name='action_refuse']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

            </field>
        </record>


        <!-- ========================================
             REJECTION WIZARD FORM
             ======================================== -->

        <record id="view_hr_leave_rejection_form" model="ir.ui.view">
            <field name="name">hr.leave.rejection.form</field>
            <field name="model">hr.leave.rejection</field>
            <field name="arch" type="xml">
                <form string="Reject Leave Request">
                    <group>
                        <field name="leave_id" readonly="1"/>
                        <field name="rejection_by" invisible="1"/>
                        <field name="rejection_reason"
                               placeholder="Please provide a reason for rejection..."
                               required="1"/>
                    </group>
                    <footer>
                        <button name="action_reject"
                                type="object"
                                string="Confirm Rejection"
                                class="btn btn-danger"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>