<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================
             EXTEND LEAVE REQUEST FORM (Odoo 18)
             ======================================== -->

        <record id="view_hr_leave_form_sequential" model="ir.ui.view">
            <field name="name">hr.leave.form.sequential</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">

                <!-- Add custom approval status fields -->
                <xpath expr="//field[@name='state']" position="after">
                    <field name="supervisor_state" readonly="1"/>
                    <field name="hr_state" readonly="1"/>
                    <field name="rejection_reason" readonly="1"/>
                </xpath>

                <!-- Insert buttons after Validate button -->
                <xpath expr="//button[@name='action_validate']" position="after">

                    <!-- Supervisor Buttons -->
                    <button name="action_supervisor_approve"
                            type="object"
                            string="Approve as Supervisor"
                            class="btn btn-success"
                            attrs="{'invisible': ['|',
                                ('supervisor_state','!=','pending'),
                                ('supervisor_id','!=',uid)
                            ]}"/>

                    <button name="action_supervisor_reject"
                            type="object"
                            string="Reject as Supervisor"
                            class="btn btn-danger"
                            attrs="{'invisible': ['|',
                                ('supervisor_state','!=','pending'),
                                ('supervisor_id','!=',uid)
                            ]}"/>

                    <!-- HR Buttons -->
                    <button name="action_hr_approve"
                            type="object"
                            string="Approve as HR"
                            class="btn btn-success"
                            attrs="{'invisible': ['|',
                                ('hr_state','!=','pending'),
                                ('supervisor_state','!=','approved')
                            ]}"/>

                    <button name="action_hr_reject"
                            type="object"
                            string="Reject as HR"
                            class="btn btn-danger"
                            attrs="{'invisible': ['|',
                                ('hr_state','!=','pending'),
                                ('supervisor_state','!=','approved')
                            ]}"/>

                </xpath>

            </field>
        </record>


        <!-- ========================================
             REJECTION WIZARD FORM
             ======================================== -->

        <record id="view_hr_leave_rejection_form" model="ir.ui.view">
            <field name="name">hr.leave.rejection.form</field>
            <field name="model">hr.leave.rejection</field>
            <field name="arch" type="xml">
                <form string="Reject Leave Request">
                    <group>
                        <field name="leave_id" readonly="1"/>
                        <field name="rejection_by" invisible="1"/>
                        <field name="rejection_reason"
                               placeholder="Please provide a reason for rejection..."
                               required="1"/>
                    </group>
                    <footer>
                        <button name="action_reject"
                                type="object"
                                string="Confirm Rejection"
                                class="btn btn-danger"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>