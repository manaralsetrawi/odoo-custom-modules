<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend hr.leave form view -->
        <record id="view_hr_leave_form_sequential" model="ir.ui.view">
            <field name="name">hr.leave.form.sequential</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id">hr_holidays.hr_leave_view_form</field>
            <field name="arch" type="xml">
                
                <!-- Add approval status fields after state field -->
                <xpath expr="//field[@name='state']" position="after">
                    <field name="supervisor_state" readonly="1"/>
                    <field name="hr_state" readonly="1"/>
                    <field name="rejection_reason" widget="html" readonly="1"/>
                </xpath>

                <!-- Add approval buttons in form -->
                <xpath expr="//button[@name='action_confirm']" position="replace">
                    <!-- Show different buttons based on user role and approval state -->
                </xpath>

                <!-- Add button section for supervisor -->
                <xpath expr="//div[@class='oe_button_box']" position="inside">
                    <div class="oe_inline" attrs="{'invisible': [('supervisor_state', '!=', 'pending')]}">
                        <button name="action_supervisor_approve" 
                                type="object" 
                                string="Approve as Supervisor" 
                                class="btn btn-success"
                                attrs="{'invisible': [('supervisor_id', '!=', uid)]}"/>
                        <button name="action_supervisor_reject" 
                                type="object" 
                                string="Reject as Supervisor" 
                                class="btn btn-danger"
                                attrs="{'invisible': [('supervisor_id', '!=', uid)]}"/>
                    </div>
                </xpath>

                <!-- Add button section for HR -->
                <xpath expr="//div[@class='oe_button_box']" position="inside">
                    <div class="oe_inline" attrs="{'invisible': [('hr_state', '!=', 'pending'), ('supervisor_state', '!=', 'approved')]}">
                        <button name="action_hr_approve" 
                                type="object" 
                                string="Approve as HR" 
                                class="btn btn-success"
                                attrs="{'invisible': [('hr_state', '!=', 'pending')]}"/>
                        <button name="action_hr_reject" 
                                type="object" 
                                string="Reject as HR" 
                                class="btn btn-danger"
                                attrs="{'invisible': [('hr_state', '!=', 'pending')]}"/>
                    </div>
                </xpath>

            </field>
        </record>

        <!-- Rejection wizard form -->
        <record id="view_hr_leave_rejection_form" model="ir.ui.view">
            <field name="name">hr.leave.rejection.form</field>
            <field name="model">hr.leave.rejection</field>
            <field name="arch" type="xml">
                <form string="Reject Leave Request">
                    <group>
                        <field name="leave_id" readonly="1"/>
                        <field name="rejection_by" invisible="1"/>
                        <field name="rejection_reason" placeholder="Please provide a reason for rejection..."/>
                    </group>
                    <footer>
                        <button name="action_reject" type="object" string="Confirm Rejection" class="btn btn-danger"/>
                        <button string="Cancel" special="cancel" class="btn btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>