<!-- Supervisor Section -->
<div style="background-color:#f8fbff; padding:20px; border-radius:10px; margin-bottom:20px; border-left:4px solid #0B2C3D;">
  <div class="row">
    <div class="col-md-6">
      <h5>Supervisor Approval</h5>

      <!-- Approve -->
      <button name="action_supervisor_approve"
              type="object"
              string="Approve"
              class="oe_highlight"
              attrs="{'invisible': ['|', ('supervisor_state','!=','pending'), ('is_current_user_supervisor','=',False)]}"
              style="width:100%; margin-bottom:10px;"/>

      <!-- Reject -->
      <button name="action_supervisor_reject"
              type="object"
              string="Reject"
              attrs="{'invisible': ['|', ('supervisor_state','!=','pending'), ('is_current_user_supervisor','=',False)]}"
              style="width:100%; margin-bottom:10px;"/>

      <!-- Reset -->
      <button name="action_supervisor_reset"
              type="object"
              string="Reset Decision"
              attrs="{'invisible': ['|', ('supervisor_state','=','pending'), ('is_current_user_supervisor','=',False)]}"
              style="width:100%;"/>
    </div>

    <div class="col-md-6">
      <h5>Status</h5>
      <field name="supervisor_state"
             widget="badge"
             decoration-success="supervisor_state == 'approved'"
             decoration-warning="supervisor_state == 'pending'"
             decoration-danger="supervisor_state == 'rejected'"
             readonly="1"/>
    </div>
  </div>
</div>

<!-- HR Section -->
<div groups="hr_holidays.group_hr_holidays_user,hr.group_hr_user"
     attrs="{'invisible': [('supervisor_state','!=','approved')]}"
     style="background-color:#f4fff7; padding:20px; border-radius:10px; margin-bottom:20px; border-left:4px solid #00b341;">
  <div class="row">
    <div class="col-md-6">
      <h5>HR Approval</h5>

      <button name="action_hr_approve"
              type="object"
              string="Approve"
              class="oe_highlight"
              attrs="{'invisible': [('hr_state','!=','pending')]}"/>
      <button name="action_hr_reject"
              type="object"
              string="Reject"
              attrs="{'invisible': [('hr_state','!=','pending')]}"/>
      <button name="action_hr_reset"
              type="object"
              string="Reset Decision"
              attrs="{'invisible': [('hr_state','=','pending')]}"/>
    </div>

    <div class="col-md-6">
      <h5>Status</h5>
      <field name="hr_state"
             widget="badge"
             decoration-success="hr_state == 'approved'"
             decoration-warning="hr_state == 'pending'"
             decoration-danger="hr_state == 'rejected'"
             readonly="1"/>
    </div>
  </div>
</div>